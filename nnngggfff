local function request()
	return (syn and syn.request) or (http and http.request) or http_request or request
end

local function githubImage()
	local req = request()
	if not req or not writefile or not getcustomasset then return nil end
	local ok, res = pcall(function()
		return req({Url=GITHUB_IMAGE,Method="GET"})
	end)
	if not ok or not res or type(res.Body) ~= "string" or #res.Body == 0 then
		return nil
	end

	local file = "saiki_1147010598883426560.jpg"
	local wrote = pcall(function()
		if isfile and isfile(file) and delfile then delfile(file) end
		writefile(file,res.Body)
	end)
	if not wrote then return nil end

	local okAsset, asset = pcall(function()
		return getcustomasset(file)
	end)
	return okAsset and asset or nil
end

