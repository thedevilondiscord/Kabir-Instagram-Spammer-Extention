local function DisplayNewMessageNotif(msgData, messageId)
    if not msgData then return end
    if msgData.IsPrivate and msgData.Username ~= LocalPlayer.Name and msgData.TargetUsername ~= LocalPlayer.Name then return end
    if msgData.Username == LocalPlayer.Name and not msgData.IsJoinMessage then return end

    messageId = tostring(messageId or ((msgData.JoinEventId or "") .. "_" .. (msgData.Timestamp or "") .. "_" .. (msgData.Username or "")))
    if ShownNotificationIds[messageId] then return end
    ShownNotificationIds[messageId] = true

    local rawName = msgData.DisplayName or msgData.Username or "Unknown"
    local isClient = (msgData.Username == LocalPlayer.Name)
    local formattedName = GetFormattedDisplayName(rawName, isClient)
    local rawText = msgData.Text or ""
    if msgData.IsJoinMessage then
        rawText = tostring(msgData.JoinedDisplayName or msgData.Text or "Unknown") .. " has Joined the Server Chat"
    elseif string.sub(rawText, 1, 11) == "rbxthumb://" or string.sub(rawText, 1, 13) == "rbxassetid://" then
        rawText = "[Sticker]"
    end
    local formattedMsg = TruncateText(rawText, 34)

    if ActiveNotifBtn and ActiveNotifBtn.Parent then
        ActiveNotifBtn:Destroy()
        ActiveNotifBtn = nil
    end

    local notifBtn = Instance.new("TextButton")
    notifBtn.Name = "MessageNotification"
    notifBtn.Size = UDim2.new(0, 360, 0, 54)
    notifBtn.Position = UDim2.new(0, 0, -1, 0)
    notifBtn.AnchorPoint = Vector2.new(0, 0)
    notifBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
    notifBtn.BackgroundTransparency = 0.22
    notifBtn.BorderSizePixel = 0
    notifBtn.Text = ""
    notifBtn.AutoButtonColor = false
    notifBtn.ZIndex = 101
    notifBtn.Parent = NotifContainerFrame

    local notifCorner = Instance.new("UICorner")
    notifCorner.CornerRadius = UDim.new(0, 12)
    notifCorner.Parent = notifBtn

    local notifStroke = Instance.new("UIStroke")
    notifStroke.Thickness = 1.8
    notifStroke.Transparency = 0.1
    notifStroke.Parent = notifBtn

    local notifGradient = Instance.new("UIGradient")
    if msgData.IsJoinMessage then
        notifGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255, 128, 0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(80, 100, 255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 255)),
        })
    else
        notifGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 40, 40)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(20, 20, 30)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 40, 40)),
        })
    end
    notifGradient.Parent = notifStroke

    local notifPfp = Instance.new("ImageLabel")
    notifPfp.Name = "NotificationPFP"
    notifPfp.Size = UDim2.new(0, 38, 0, 38)
    notifPfp.Position = UDim2.new(0, 8, 0.5, -19)
    notifPfp.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    notifPfp.BackgroundTransparency = 0.08
    notifPfp.Image = "rbxthumb://type=Asset&id=" .. tostring(msgData.PfpId or DefaultPfpId) .. "&w=150&h=150"
    notifPfp.ZIndex = 102
    notifPfp.Parent = notifBtn

    local pfpCorner = Instance.new("UICorner")
    pfpCorner.CornerRadius = UDim.new(1, 0)
    pfpCorner.Parent = notifPfp

    local pfpStroke = Instance.new("UIStroke")
    pfpStroke.Thickness = 1.2
    pfpStroke.Color = msgData.IsJoinMessage and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 55, 55)
    pfpStroke.Transparency = 0.15
    pfpStroke.Parent = notifPfp

    local notifText = Instance.new("TextLabel")
    notifText.Size = UDim2.new(1, -58, 1, -8)
    notifText.Position = UDim2.new(0, 54, 0, 4)
    notifText.BackgroundTransparency = 1
    notifText.Font = Enum.Font.GothamBold
    notifText.Text = msgData.IsJoinMessage and (tostring(msgData.JoinedDisplayName or "Unknown") .. " has Joined the Server Chat") or (formattedName .. " : " .. formattedMsg)
    notifText.TextColor3 = Color3.fromRGB(245, 245, 250)
    notifText.TextSize = 11
    notifText.TextWrapped = true
    notifText.TextXAlignment = Enum.TextXAlignment.Left
    notifText.TextYAlignment = Enum.TextYAlignment.Center
    notifText.ZIndex = 102
    notifText.Parent = notifBtn

    task.spawn(function()
        while notifBtn and notifBtn.Parent do
            local dt = RunService.RenderStepped:Wait()
            notifGradient.Rotation = (notifGradient.Rotation + (65 * dt)) % 360
        end
    end)

    ActiveNotifBtn = notifBtn
    PlayNotificationSound(msgData.IsJoinMessage and JOIN_SOUND_ID or NOTIFICATION_SOUND_ID)

    TweenService:Create(notifBtn, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    task.delay(3.5, function()
        if ActiveNotifBtn == notifBtn and notifBtn and notifBtn.Parent then
            ActiveNotifBtn = nil
            local slideOut = TweenService:Create(notifBtn, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Position = UDim2.new(0, 0, -1, 0)
            })
            slideOut:Play()
            slideOut.Completed:Wait()
            if notifBtn and notifBtn.Parent then notifBtn:Destroy() end
        end
    end)

    notifBtn.Activated:Connect(function()
        if ActiveNotifBtn == notifBtn then ActiveNotifBtn = nil end
        local slideOut = TweenService:Create(notifBtn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, 0, -1, 0)
        })
        slideOut:Play()
        slideOut.Completed:Wait()
        if notifBtn and notifBtn.Parent then notifBtn:Destroy() end
    end)
end

