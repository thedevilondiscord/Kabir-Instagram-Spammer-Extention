local function MusicPlayTrack(track, announce)
    if type(track) ~= "table" then return end
    local id = tostring(track.id or track.ID or track.Id or "")
    local name = tostring(track.name or track.Name or "Unknown")
    local timestamp = tonumber(track.timestamp or track.Timestamp) or os.time()
    if id == "" then return end

    local signature = id .. "|" .. tostring(timestamp)
    if MusicState.CurrentSignature == signature then return end
    MusicState.CurrentSignature = signature
    MusicState.CurrentTrack = {name=name, id=id, timestamp=timestamp}

    local soundId = id:match("^rbxassetid://") and id or ("rbxassetid://" .. id)
    local played = pcall(function()
        MusicSessionSound:Stop()
        MusicSessionSound.SoundId = soundId
        MusicSessionSound.Volume = MusicState.Muted and 0 or 0.5
        MusicSessionSound.TimePosition = 0
        MusicSessionSound:Play()
    end)
    if not played then
        MusicSetStatus("Unable to play the selected audio.", true)
        return
    end

    if MusicState.IsHost then
        MusicHostNowPlaying.Text = "Now Playing: " .. name
    else
        MusicParticipantNowPlaying.Text = "Now Playing: " .. name
        if announce then
            task.spawn(function()
                pcall(function()
                    ShowLocalSystemMessage("[Music Session] Now playing: " .. name, false)
                end)
            end)
        end
    end

    task.spawn(function()
        for _ = 1, 50 do
            if not MusicSessionSound or not MusicSessionSound.Parent then return end
            if MusicState.CurrentSignature ~= signature then return end
            if MusicSessionSound.IsLoaded or MusicSessionSound.TimeLength > 0 then
                local elapsed = math.max(0, os.time() - timestamp)
                local length = tonumber(MusicSessionSound.TimeLength) or 0
                if length > 0 and elapsed < length then
                    pcall(function() MusicSessionSound.TimePosition = elapsed end)
                elseif length > 0 and elapsed >= length then
                    MusicSessionSound:Stop()
                end
                return
            end
            task.wait(0.1)
        end
    end)
end

