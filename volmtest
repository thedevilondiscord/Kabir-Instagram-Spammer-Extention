end

SendChatMessage = function()
    local typedText = MessageInput.Text or ""
    if typedText == "" or typedText:match("^%s*$") then return end

    local isPrivate = IsPrivateModeActive()
    local privateTargetUsername = PrivateModeTargetUsername
    local privateTargetDisplayName = PrivateModeTargetDisplayName
    local privateBody = typedText

    -- PVT is determined only by the stored recipient state.
    -- There is no special prefix in the TextBox to delete or accidentally edit.
    if isPrivate then
        if not privateTargetUsername then return end
        privateBody = typedText
        if privateBody:match("^%s*$") then return end
    end

    if not isPrivate then
        local currentScope = (ActiveTab == "GLOBAL") and "GLOBAL" or "SERVER"
        local ownMute = Moderation.GetActiveMute(currentScope, LocalPlayer.Name)
        if ownMute then
            local remaining = Moderation.FormatMuteRemaining((tonumber(ownMute.ExpiresAt) or os.time()) - os.time())
            local imposedBy = tostring(ownMute.ImposedByDisplayName or "Moderator")
            ShowLocalSystemMessage("[AI MoD] : 🔇 You can't chat for the next " .. remaining .. " due to a mute enforced by " .. imposedBy .. ".", true)
            MessageInput.Text = ""
            return
        end
    end

    if not isPrivate and typedText == "!testnotif" then
        TestNotification()
        ShowLocalSystemMessage("[AI MoD] : Notification test triggered successfully ✓")
        MessageInput.Text = ""
        return
    elseif not isPrivate and typedText == "!notify" then
        TestNotification()
        ShowLocalSystemMessage("[AI MoD] : Notification test triggered successfully ✓")
        MessageInput.Text = ""
        return
    elseif not isPrivate and typedText == "!joined" then
        ShowLocalJoinMessage()
        ShowLocalSystemMessage("[AI MoD] : Join-message test triggered successfully ✓")
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 9) == "!announce" then
        if not CanUseAnnouncement(LocalPlayer.Name) then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Only Architect, Overseer and Moderator can use !announce.", true)
            MessageInput.Text = ""
            return
        end
        local body = typedText:sub(10):gsub("^%s+", "")
        if body == "" then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Usage: !announce [Text].", true)
            MessageInput.Text = ""
            return
        end
        if #body > 900 then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Announcement must be 900 characters or fewer.", true)
            MessageInput.Text = ""
            return
        end
        Moderation.SendAnnouncement(body)
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 6) == "!mute " then
        if not CanUseModerationCommands(LocalPlayer.Name) then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Only Architect, Overseer and Moderator can use !mute.", true)
            MessageInput.Text = ""
            return
        end
        local argsText = typedText:sub(7)
        local durationText, targetQuery = argsText:match("^(%d+)%s+(.+)$")
        local duration = tonumber(durationText)
        if not duration or duration < 1 or duration > 15 or not targetQuery or targetQuery:match("^%s*$") then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Usage: !mute [1-15 minutes] [DisplayName / Username / prefix].", true)
            MessageInput.Text = ""
            return
        end
        local targetUsername, targetDisplayName = Moderation.ResolveModerationTarget(targetQuery)
        if not targetUsername then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Player not found. Use their DisplayName, Username, or a unique prefix.", true)
            MessageInput.Text = ""
            return
        end
        Moderation.SendMute(targetUsername, targetDisplayName, duration)
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 5) == "!tag " then
        local requestedRole = string.sub(typedText, 6):gsub("^%s+", ""):gsub("%s+$", "")
        local canonical = FindCanonicalRole(requestedRole)
        if not canonical or not PlayerHasRole(LocalPlayer.Name, canonical) then
            ShowLocalSystemMessage("[AI MoD] : Command failed. You are not assigned to the role '" .. requestedRole .. "' in the GitHub roster.", true)
        else
            AssignedPlayerRoles[LocalPlayer.Name] = canonical
            DisabledTags[LocalPlayer.Name] = nil
            ShowLocalSystemMessage("[AI MoD] : Tag changed successfully to " .. canonical .. " ✓")
        end
        MessageInput.Text = ""
        return
    elseif not isPrivate and typedText == "!tag" then
        DisabledTags[LocalPlayer.Name] = not DisabledTags[LocalPlayer.Name]
        ShowLocalSystemMessage("[AI MoD] : Tag display " .. (DisabledTags[LocalPlayer.Name] and "disabled" or "enabled") .. " ✓")
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 6) == "!role " then
        local targetQuery = string.sub(typedText, 7):gsub("^%s+", ""):gsub("%s+$", "")
        local targetUsername, targetDisplayName = Moderation.ResolveModerationTarget(targetQuery)
        if not targetUsername then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Player not found.", true)
        else
            local roles = GetPlayerRoles(targetUsername)
            local highest = GetHighestRole(targetUsername)
            local text = #roles > 0 and table.concat(roles, ", ") or "No GitHub roles"
            ShowLocalSystemMessage("[AI MoD] : " .. targetDisplayName .. " — Highest: " .. highest .. " | Roles: " .. text)
        end
        MessageInput.Text = ""
        return
    elseif not isPrivate and typedText == "!role" then
        local roles = GetPlayerRoles(LocalPlayer.Name)
        local highest = GetHighestRole(LocalPlayer.Name)
        ShowLocalSystemMessage("[AI MoD] : Your highest role is " .. highest .. ". Available roles: " .. (#roles > 0 and table.concat(roles, ", ") or "none") .. ".")
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 7) == "!spoof " then
        local requested = string.sub(typedText, 8)
        local lowered = string.lower(requested)
        if lowered == "architect" or lowered == "overseer" or lowered == "com-god" then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Architect, Overseer and Com-God cannot be spoofed.", true)
        elseif CanUseSpoof(LocalPlayer.Name) then
            SpoofedDisplayName = requested
            ShowLocalSystemMessage("[AI MoD] : Display name changed successfully ✓")
        else
            ShowLocalSystemMessage("[AI MoD] : Command failed. You do not have permission to use !spoof.", true)
        end
        MessageInput.Text = ""
        return
    elseif not isPrivate and typedText == "!spoof" then
        ShowLocalSystemMessage("[AI MoD] : Command failed. Usage: !spoof [NewName].", true)
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 1) == "!" then
        ShowLocalSystemMessage("[AI MoD] : Unknown command. Command failed.", true)
        MessageInput.Text = ""
        return
    end

    -- Anti-spam applies to the actual message body, not the hidden PVT state.
    local spamText = privateBody
    local now = tick()
    if spamText == LastSentMessageText and (now - LastMessageSendTime) <= 30 then
        ConsecutiveSpamCount = ConsecutiveSpamCount + 1
    else
        ConsecutiveSpamCount = 1
    end

    if ConsecutiveSpamCount >= 3 then
        ShowAntiSpamMessage()
        MessageInput.Text = ""
        return
    end

    LastSentMessageText = spamText
    LastMessageSendTime = now

    local reply = ReplyContextMessage
    local clientMessageId = LocalPlayer.UserId .. "_" .. tostring(math.floor(os.clock() * 1000000)) .. "_" .. tostring(math.random(100000, 999999))

    local payload = {
        ClientMessageId = clientMessageId,
        Username = LocalPlayer.Name,
        DisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
        Text = privateBody,
        Timestamp = os.time(),
        Role = GetAssignedOrCalculatedRole(LocalPlayer.Name),
        PfpId = CurrentPfpId,
        IsPrivate = isPrivate,
        TargetUsername = privateTargetUsername,
        TargetDisplayName = privateTargetDisplayName,
        ReplyToUsername = reply and reply.Username or nil,
        ReplyToDisplayName = reply and reply.DisplayName or nil,
        ReplyToText = reply and reply.Text or nil,
        ReplyToTimestamp = reply and reply.Timestamp or nil
    }

    -- Render immediately. The UI no longer waits for Firebase at all.
    local localCache = (ActiveTab == "GLOBAL") and GlobalCachedMessages or ServerCachedMessages
    local localUI = (ActiveTab == "GLOBAL") and GlobalUIElements or ServerUIElements
    local localKey = "local_" .. clientMessageId

    localCache[localKey] = payload
    local immediateCard = CreateMessageCard(payload, ActiveTab == "GLOBAL")
    immediateCard.Visible = true
    table.insert(localUI, immediateCard)

    MessageInput.Text = ""
    ReplyContextMessage = nil
    RefreshReplyUI()

    -- Firebase persistence is asynchronous and starts immediately after the
    -- local render. A deterministic client id lets polling recognize the
    -- same message and prevents a second copy from appearing.
    local targetUrl = (ActiveTab == "GLOBAL") and GLOBAL_MESSAGES_ENDPOINT or SERVER_MESSAGES_ENDPOINT
    task.spawn(function()
        local ok = pcall(function()
            HttpRequest(targetUrl, "POST", payload)
        end)
        if not ok then
            -- Keep the already-rendered local message; Firebase failure does
            -- not make the chat feel delayed or erase the user's message.
        end
    end)
end

