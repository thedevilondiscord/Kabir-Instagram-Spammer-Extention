local function RoleNameEquals(a, b)
    return string.lower(tostring(a or "")) == string.lower(tostring(b or ""))
end

local function FindCanonicalRole(roleName)
    for _, candidate in ipairs(ROLE_PRIORITY) do
        if RoleNameEquals(candidate, roleName) then return candidate end
    end
    return nil
end

local function GetPlayerRoles(username)
    return AvailableUserRoles[username] or {}
end

local function GetHighestRole(username)
    local roles = GetPlayerRoles(username)
    local best, bestIndex
    for _, roleName in ipairs(roles) do
        local canonical = FindCanonicalRole(roleName) or roleName
        local idx = ROLE_PRIORITY_INDEX[canonical] or 9999
        if not bestIndex or idx < bestIndex then
            best, bestIndex = canonical, idx
        end
    end
    return best or "VIP"
end

local function PlayerHasRole(username, roleName)
    for _, assignedRole in ipairs(GetPlayerRoles(username)) do
        if RoleNameEquals(assignedRole, roleName) then return true end
    end
    return false
end

local function GetAssignedOrCalculatedRole(username)
    local selected = AssignedPlayerRoles[username]
    if selected and PlayerHasRole(username, selected) then
        return FindCanonicalRole(selected) or selected
    end
    return GetHighestRole(username)
end

local function HasRolePermission(username, permission)
    local role = GetAssignedOrCalculatedRole(username)
    local perms = ROLE_PERMISSIONS[role]
    return perms and perms[permission] == true or false
end

local function HasAdminPermission(username)
    return HasRolePermission(username, "Kick") or HasRolePermission(username, "Ban") or HasRolePermission(username, "Mute")
end

local function CanUseSpoof(username) return HasRolePermission(username, "Spoof") end
local function CanUseAnnouncement(username) return HasRolePermission(username, "Announce") end
local function CanUseModerationCommands(username) return HasRolePermission(username, "Announce") or HasRolePermission(username, "Mute") end
local function CanUseKick(username) return HasRolePermission(username, "Kick") end
local function CanUseBan(username) return HasRolePermission(username, "Ban") end
local function CanUsePlayMusic(username) return HasRolePermission(username, "PlayMusic") end

