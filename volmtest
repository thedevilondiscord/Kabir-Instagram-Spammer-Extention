local function MusicRenderTracks()
    for _, child in ipairs(MusicTrackScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local songs = MusicState.Catalog[MusicState.Category] or {}
    local query = string.lower(tostring(MusicSearchInput.Text or ""))
    local order = 0
    for _, song in ipairs(songs) do
        local name = tostring(song.name or "")
        if query == "" or name:lower():find(query, 1, true) then
            order += 1
            local button = MusicButton(MusicTrackScroll, "MusicTrack_" .. order, name, UDim2.new(1, -4, 0, 28), UDim2.new())
            button.LayoutOrder = order
            button.TextXAlignment = Enum.TextXAlignment.Left
            button.MouseButton1Click:Connect(function()
                if not MusicState.IsHost or not MusicState.SessionId then
                    MusicErrorLabel.Text = "Only the host can change tracks."
                    return
                end
                local url = MusicURL(MusicState.SessionId, "/currentTrack")
                local payload = {name=name, id=tostring(song.id), timestamp={ [".sv"] = "timestamp" }}
                local ok = MusicHTTP(url, "PUT", payload)
                if not ok then
                    MusicErrorLabel.Text = "Failed to update the music session."
                    return
                end
                local readOk, track = MusicHTTP(url, "GET")
                if readOk and type(track) == "table" then
                    MusicPlayTrack(track, false)
                    MusicSetStatus("Hosting • Now Playing: " .. tostring(track.name or name))
                else
                    payload.timestamp = os.time()
                    MusicPlayTrack(payload, false)
                    MusicSetStatus("Hosting • Now Playing: " .. name)
                end
            end)
        end
    end
end

local function MusicLoadCatalog()
    task.spawn(function()
        local catalog = nil
        local ok, raw = pcall(function()
            if http_req then
                local executorOk, response = pcall(function()
                    return http_req({Url=MUSIC_SESSION_CATALOG_URL, Method="GET", Headers={ ["Content-Type"]="application/json" }})
                end)
                if executorOk and response and response.Body then return response.Body end
            end
            return HttpService:GetAsync(MUSIC_SESSION_CATALOG_URL, true)
        end)
        if ok and type(raw) == "string" and raw ~= "" then
            local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
            if decodeOk then catalog = MusicNormalizeCatalog(decoded) end
        end
        if not catalog or not next(catalog) then
            catalog = MusicNormalizeCatalog(MUSIC_SESSION_FALLBACK)
        end
        MusicState.Catalog = catalog
        task.defer(function()
            for _, child in ipairs(MusicCategoryScroll:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            local categories = {"Songs", "Hindi", "Bhojpuri", "Phonk", "MultiLang", "Sounds"}
            for index, category in ipairs(categories) do
                local b = MusicButton(MusicCategoryScroll, "MusicCategory_" .. category, category, UDim2.new(0, math.max(56, #category * 6 + 20), 0, 24), UDim2.new())
                b.LayoutOrder = index
                b.BackgroundColor3 = category == MusicState.Category and Color3.fromRGB(190, 30, 35) or Color3.fromRGB(35, 35, 48)
                b.MouseButton1Click:Connect(function()
                    MusicState.Category = category
                    for _, child in ipairs(MusicCategoryScroll:GetChildren()) do
                        if child:IsA("TextButton") then
                            child.BackgroundColor3 = (child == b) and Color3.fromRGB(190, 30, 35) or Color3.fromRGB(35, 35, 48)
                        end
                    end
                    MusicRenderTracks()
                end)
            end
            MusicRenderTracks()
        end)
    end)
end

local function MusicStopPolling()
    MusicState.PollToken += 1
end

local function MusicLeave(showMessage)
    local sessionId = MusicState.SessionId
    local wasHost = MusicState.IsHost
    MusicStopPolling()
    MusicStopSound()
    if sessionId then
        local url = wasHost and MusicURL(sessionId) or MusicURL(sessionId, "/members/" .. tostring(LocalPlayer.UserId))
        if url then task.spawn(function() pcall(function() MusicHTTP(url, "DELETE") end) end) end
    end
    MusicReset(showMessage and "You left the music session." or "Not in a music session.")
end

local function MusicStartPolling(sessionId, host)
    MusicStopPolling()
    local token = MusicState.PollToken
    task.spawn(function()
        while MusicState.PollToken == token and MusicState.SessionId == sessionId do
            local ok, session = MusicGet(sessionId)
            if not ok then
                MusicSetStatus("Music Session: Firebase unavailable; retrying...", true)
                task.wait(2)
            elseif type(session) ~= "table" then
                MusicReset("The music session has ended.")
                break
            else
                local current = session.currentTrack
                if not host then
                    MusicParticipantHostLabel.Text = "Host: " .. tostring(session.hostUserId or "Unknown")
                end
                if type(current) == "table" and current.id then
                    MusicPlayTrack(current, not host)
                elseif MusicState.CurrentSignature ~= "" then
                    MusicState.CurrentSignature = ""
                    MusicState.CurrentTrack = nil
                    MusicStopSound()
                    if host then MusicHostNowPlaying.Text = "Now Playing: Nothing" else MusicParticipantNowPlaying.Text = "Now Playing: Nothing" end
                end
                if host then
                    MusicSetStatus("Hosting • Session " .. sessionId)
                else
                    MusicSetStatus("Joined • Session " .. sessionId)
                end
                task.wait(1)
            end
        end
    end)
end

local function MusicCreateSession()
    if MusicState.SessionId then
        MusicErrorLabel.Text = "You are already in a music session."
        return
    end
    CreateMusicSessionButton.Text = "CREATING..."
    CreateMusicSessionButton.Active = false
    task.spawn(function()
        local created = nil
        for _ = 1, 8 do
            local candidate = MusicGenerateId()
            local checkOk, existing = MusicGet(candidate)
            if checkOk and existing == nil then
                local payload = {hostUserId=tostring(LocalPlayer.UserId), currentTrack=nil, members={[tostring(LocalPlayer.UserId)] = true}}
                local writeOk = MusicHTTP(MusicURL(candidate), "PUT", payload)
                if writeOk then created = candidate break end
            elseif not checkOk then
                break
            end
        end
        CreateMusicSessionButton.Text = "CREATE MUSIC SESSION"
        CreateMusicSessionButton.Active = true
        if not created then
            MusicErrorLabel.Text = "Unable to create the session. Check HTTP/Firebase access."
            return
        end
        MusicState.SessionId = created
        MusicState.IsHost = true
        MusicState.CurrentSignature = ""
        MusicState.CurrentTrack = nil
        MusicSessionLabel.Text = "SESSION: " .. created
        MusicNotInSessionFrame.Visible = false
        MusicHostFrame.Visible = true
        MusicParticipantFrame.Visible = false
        MusicSetStatus("Hosting • Session " .. created)
        MusicErrorLabel.Text = ""
        MusicStartPolling(created, true)
    end)
end

local function MusicJoinSession()
    if MusicState.SessionId then
        MusicErrorLabel.Text = "You are already in a music session."
        return
    end
    local id = string.upper(tostring(MusicJoinInput.Text or ""):gsub("%s+", ""))
    if not id:match("^[A-Z0-9]{6}$") then
        MusicErrorLabel.Text = "Invalid Session ID. Enter the 6-character code."
        return
    end
    JoinMusicSessionButton.Text = "CHECKING..."
    JoinMusicSessionButton.Active = false
    task.spawn(function()
        local ok, session = MusicGet(id)
        if not ok then
            JoinMusicSessionButton.Text = "JOIN"
            JoinMusicSessionButton.Active = true
            MusicErrorLabel.Text = "Could not contact Firebase."
            return
        end
        if type(session) ~= "table" or not session.hostUserId then
            JoinMusicSessionButton.Text = "JOIN"
            JoinMusicSessionButton.Active = true
            MusicErrorLabel.Text = "Invalid Session ID."
            return
        end
        local memberUrl = MusicURL(id, "/members/" .. tostring(LocalPlayer.UserId))
        local addOk = MusicHTTP(memberUrl, "PUT", true)
        if not addOk then
            JoinMusicSessionButton.Text = "JOIN"
            JoinMusicSessionButton.Active = true
            MusicErrorLabel.Text = "Could not join the session."
            return
        end
        MusicState.SessionId = id
        MusicState.IsHost = false
        MusicState.CurrentSignature = ""
        MusicState.CurrentTrack = nil
        MusicParticipantSessionLabel.Text = "SESSION: " .. id
        MusicParticipantHostLabel.Text = "Host: " .. tostring(session.hostUserId)
        MusicParticipantNowPlaying.Text = "Now Playing: Nothing"
        MusicNotInSessionFrame.Visible = false
        MusicHostFrame.Visible = false
        MusicParticipantFrame.Visible = true
        JoinMusicSessionButton.Text = "JOIN"
        JoinMusicSessionButton.Active = true
        MusicErrorLabel.Text = ""
        MusicSetStatus("Joined • Session " .. id)
        if type(session.currentTrack) == "table" then MusicPlayTrack(session.currentTrack, true) end
        MusicStartPolling(id, false)
    end)
end

local function MusicInvite(scope)
    if not MusicState.SessionId or not MusicState.IsHost then
        MusicSetStatus("Only the host can send an invite.", true)
        return
    end
    local endpoint = scope == "GLOBAL" and GLOBAL_MESSAGES_ENDPOINT or SERVER_MESSAGES_ENDPOINT
    local payload = {
        ClientMessageId = LocalPlayer.UserId .. "_music_" .. tostring(math.floor(os.clock() * 1000000)) .. "_" .. tostring(math.random(100000, 999999)),
        Username = LocalPlayer.Name,
        DisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
        Text = "[Music Session] Join my session using ID: " .. MusicState.SessionId,
        Timestamp = os.time(),
        Role = GetAssignedOrCalculatedRole(LocalPlayer.Name),
        PfpId = CurrentPfpId,
        IsPrivate = false,
    }
    task.spawn(function()
        local ok = MusicHTTP(endpoint, "POST", payload)
        MusicSetStatus(ok and ("Invite sent to " .. scope .. " chat.") or "Failed to send invite.", not ok)
    end)
end

