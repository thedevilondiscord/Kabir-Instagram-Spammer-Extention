Moderation.NormalizeName = function(s)
    return string.lower(tostring(s or ""))
end

Moderation.ResolveModerationTarget = function(query)
    query = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if query == "" then return nil end
    local needle = Moderation.NormalizeName(query)

    local function checkPlayer(player)
        local name = Moderation.NormalizeName(player.Name)
        local display = Moderation.NormalizeName(player.DisplayName)
        if name == needle or display == needle then return player.Name, player.DisplayName end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        local u, d = checkPlayer(player)
        if u then return u, d end
    end

    local bestUsername, bestDisplay
    for _, player in ipairs(Players:GetPlayers()) do
        local name = Moderation.NormalizeName(player.Name)
        local display = Moderation.NormalizeName(player.DisplayName)
        if string.sub(name, 1, #needle) == needle or string.sub(display, 1, #needle) == needle then
            if not bestUsername then
                bestUsername, bestDisplay = player.Name, player.DisplayName
            end
        end
    end
    if bestUsername then return bestUsername, bestDisplay end

    for _, cache in ipairs({GlobalCachedMessages, ServerCachedMessages}) do
        for _, msg in pairs(cache) do
            if type(msg) == "table" then
                local username = tostring(msg.Username or "")
                local display = tostring(msg.DisplayName or username)
                local lu, ld = Moderation.NormalizeName(username), Moderation.NormalizeName(display)
                if lu == needle or ld == needle or string.sub(lu, 1, #needle) == needle or string.sub(ld, 1, #needle) == needle then
                    return username, display
                end
            end
        end
    end
    return nil
end

Moderation.GetMuteKey = function(scope, username)
    return tostring(scope) .. "|" .. Moderation.NormalizeName(username)
end

Moderation.GetActiveMute = function(scope, username)
    local key = Moderation.GetMuteKey(scope, username)
    local mute = Moderation.ActiveMutes[key]
    if mute and tonumber(mute.ExpiresAt or 0) > os.time() then
        return mute
    end
    Moderation.ActiveMutes[key] = nil
    return nil
end

Moderation.FormatMuteRemaining = function(seconds)
    seconds = math.max(0, math.floor(tonumber(seconds) or 0))
    local minutes = math.floor(seconds / 60)
    local secs = seconds % 60
    return string.format("%02d:%02d", minutes, secs)
end

