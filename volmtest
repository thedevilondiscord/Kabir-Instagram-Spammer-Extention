local function MusicURL(sessionId, suffix)
    local id = tostring(sessionId or "")
    if id == "" or not id:match("^[A-Z0-9]{6}$") then return nil end
    local tail = tostring(suffix or "")
    if tail ~= "" and tail:sub(1, 1) ~= "/" then tail = "/" .. tail end
    return MUSIC_SESSION_FIREBASE_URL .. "sessions/" .. id .. tail .. ".json"
end

local function MusicHTTP(url, method, body)
    if type(url) ~= "string" or url == "" then return false, nil end
    method = string.upper(tostring(method or "GET"))
    local encoded = nil
    if body ~= nil then
        local ok, result = pcall(function() return HttpService:JSONEncode(body) end)
        if not ok then return false, nil end
        encoded = result
    end

    if http_req then
        local ok, response = pcall(function()
            return http_req({
                Url = url,
                Method = method,
                Headers = { ["Content-Type"] = "application/json" },
                Body = encoded,
            })
        end)
        if ok and response and response.Body ~= nil then
            local raw = tostring(response.Body)
            if raw == "" then return true, nil end
            local decodedOk, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
            if decodedOk then return true, decoded end
        elseif ok and response then
            return true, nil
        end
    end

    local ok, response = pcall(function()
        return HttpService:RequestAsync({
            Url = url,
            Method = method,
            Headers = { ["Content-Type"] = "application/json" },
            Body = encoded,
        })
    end)
    if not ok or not response then return false, nil end

    local raw = response.Body
    if raw == nil or raw == "" then return true, nil end
    local decodedOk, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
    if not decodedOk then return false, nil end
    return true, decoded
end

local function MusicGet(sessionId)
    local url = MusicURL(sessionId)
    if not url then return false, nil end
    return MusicHTTP(url, "GET")
end

local function MusicNormalizeCatalog(source)
    local result = {}
    if type(source) ~= "table" then return result end
    for category, songs in pairs(source) do
        if type(songs) == "table" then
            local list = {}
            for _, song in pairs(songs) do
                if type(song) == "table" then
                    local name = song.name or song.Name or song.title or song.Title
                    local id = song.id or song.ID or song.Id or song.assetId or song.AssetId
                    if name and id and tostring(name) ~= "" and tostring(id) ~= "" then
                        table.insert(list, {name=tostring(name), id=tostring(id)})
                    end
                end
            end
            result[tostring(category)] = list
        end
    end
    return result
end

local function MusicGenerateId()
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local out = {}
    for i = 1, 6 do
