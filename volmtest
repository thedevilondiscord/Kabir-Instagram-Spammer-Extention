local function ShowCommandAutocomplete()
    if not MessageInput then return end

    HideCommandAutocomplete()

    local typed = MessageInput.Text or ""
    local lower = string.lower(typed)
    local command = nil
    local query = ""

    if lower == "!tag" or lower:sub(1, 5) == "!tag " then
        command = "!tag "
        query = typed:sub(6)
    elseif lower == "!spoof" or lower:sub(1, 7) == "!spoof " then
        command = "!spoof "
        query = typed:sub(8)
    elseif lower == "!mute" or lower:sub(1, 6) == "!mute " then
        command = "!mute "
        query = typed:sub(7)
    elseif lower == "!announce" then
        command = "!announce "
        query = ""
    else
        return
    end

    local suggestions = {}
    local seen = {}

    if command == "!announce " then
        -- Show !announce in autocomplete only to roles that can actually use it.
        if not CanUseAnnouncement(LocalPlayer.Name) then
            return
        end
        table.insert(suggestions, "!announce ")
    elseif command == "!tag " then
        for roleName in pairs(RANK_STYLES) do
            if not seen[roleName] then
                table.insert(suggestions, roleName)
                seen[roleName] = true
            end
        end
        for _, roles in pairs(AvailableUserRoles) do
            for _, roleName in ipairs(roles) do
                if not seen[roleName] then
                    table.insert(suggestions, roleName)
                    seen[roleName] = true
                end
            end
        end
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                table.insert(suggestions, player.DisplayName)
            end
        end
    end

    table.sort(suggestions, function(a, b)
        return string.lower(a) < string.lower(b)
    end)

    local q = string.lower(query)
    local shown = 0

    for _, suggestion in ipairs(suggestions) do
        if q == "" or string.sub(string.lower(suggestion), 1, #q) == q then
            local button = Instance.new("TextButton")
            button.Size = UDim2.new(1, -8, 0, 24)
            button.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            button.BackgroundTransparency = 0.15
            button.BorderSizePixel = 0
            button.Font = Enum.Font.GothamMedium
            button.Text = "  " .. suggestion
            button.TextColor3 = Color3.fromRGB(235, 235, 240)
            button.TextSize = 10
            button.TextXAlignment = Enum.TextXAlignment.Left
            button.ZIndex = 31
            button.Parent = AutoCompleteFrame

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 6)
            corner.Parent = button

            local stroke = Instance.new("UIStroke")
            stroke.Thickness = 1
            stroke.Color = Color3.fromRGB(255, 0, 0)
            stroke.Transparency = 0.65
            stroke.Parent = button

            button.MouseEnter:Connect(function()
                button.BackgroundColor3 = Color3.fromRGB(55, 25, 35)
            end)
            button.MouseLeave:Connect(function()
                button.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            end)
            button.MouseButton1Click:Connect(function()
                local selectedCommand = (command == "!announce ") and command or (command .. suggestion)
                HideCommandAutocomplete()

                -- Setting the textbox after removing the old suggestions avoids
                -- TextChanged rebuilding the list during the click event.
                MessageInput.Text = selectedCommand
                MessageInput.CursorPosition = #selectedCommand + 1
                MessageInput:CaptureFocus()
            end)

            button.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then
                    local selectedCommand = (command == "!announce ") and command or (command .. suggestion)
                    HideCommandAutocomplete()
                    MessageInput.Text = selectedCommand
                    MessageInput.CursorPosition = #selectedCommand + 1
                    MessageInput:CaptureFocus()
                end
            end)

            shown = shown + 1
            if shown >= 6 then break end
        end
    end

    AutoCompleteFrame.Visible = shown > 0
end

