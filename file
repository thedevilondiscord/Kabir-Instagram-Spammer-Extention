local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer

-- Angel Halo Settings
local radius = 2.0
local height = 2.3
local thickness = 0.22
local segments = 31
local rotationSpeed = 0.8

local rotation = 0
local parts = {}
local joints = {}

-- Stronger Glow Effect
local bloom = Instance.new("BloomEffect")
bloom.Name = "AngelHaloGlow"
bloom.Intensity = 2.4
bloom.Size = 56
bloom.Threshold = 0.7
bloom.Parent = Lighting


-- Halo Container
local halo = Instance.new("Model")
halo.Name = "AngelHalo"
halo.Parent = workspace.CurrentCamera


-- Main golden angel ring
for i = 1, segments do
	
	local p = Instance.new("Part")
	p.Material = Enum.Material.Neon
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CastShadow = false
	p.Parent = halo
	
	table.insert(parts,p)


	local s = Instance.new("Part")
	s.Material = Enum.Material.Neon
	s.Shape = Enum.PartType.Ball
	s.Anchored = true
	s.CanCollide = false
	s.CastShadow = false
	s.Parent = halo
	
	table.insert(joints,s)

end


-- White glowing border ring
local borderParts = {}

for i = 1, segments do

	local b = Instance.new("Part")
	b.Material = Enum.Material.Neon
	b.Shape = Enum.PartType.Cylinder
	b.Anchored = true
	b.CanCollide = false
	b.CastShadow = false
	b.Size = Vector3.new(0.1,0.08,0.08)
	b.Color = Color3.fromRGB(255,255,255)
	b.Parent = halo

	table.insert(borderParts,b)

end



RunService.RenderStepped:Connect(function(dt)

	local char = player.Character
	if not char then return end

	local head = char:FindFirstChild("Head")
	if not head then return end


	rotation += dt * rotationSpeed


	local center =
		head.CFrame
		* CFrame.new(0,height,0)
		* CFrame.Angles(0,rotation,0)


	local positions = {}

	for i = 1,segments+1 do
		
		local angle = (i/segments)*math.pi*2
		
		local x = math.cos(angle)*radius
		local z = math.sin(angle)*radius
		
		local wave = math.sin(tick()*1.2+angle)*0.02
		
		table.insert(
			positions,
			center * Vector3.new(x,wave,z)
		)

	end



	for i = 1,segments do
		
		local pos1 = positions[i]
		local pos2 = positions[i+1]


		local angelColor = Color3.fromRGB(255,235,140)
		local white = Color3.fromRGB(255,255,255)



		-- Golden Angel Core
		local p = parts[i]
		p.Size = Vector3.new(
			(pos2-pos1).Magnitude,
			thickness,
			thickness
		)

		p.CFrame =
			CFrame.lookAt(
				pos1:Lerp(pos2,0.5),
				pos2
			)
			*CFrame.Angles(0,math.rad(90),0)

		p.Color = angelColor



		-- glowing joints
		local s = joints[i]
		s.Size = Vector3.new(
			thickness*1.3,
			thickness*1.3,
			thickness*1.3
		)

		s.CFrame = CFrame.new(pos1)
		s.Color = angelColor



		-- White border glow
		local b = borderParts[i]

		b.Size = Vector3.new(
			(pos2-pos1).Magnitude+0.05,
			0.06,
			0.06
		)

		b.CFrame =
			CFrame.lookAt(
				pos1:Lerp(pos2,0.5),
				pos2
			)
			*CFrame.Angles(0,math.rad(90),0)

	end

end)
