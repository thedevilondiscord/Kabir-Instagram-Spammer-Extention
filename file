-- Simple Mahoraga Wheel

local Players=game:GetService("Players")
local RunService=game:GetService("RunService")

local player=Players.LocalPlayer

local folder=Instance.new("Folder")
folder.Name="MahoragaWheel"
folder.Parent=workspace

local SCALE=0.6
local DISTANCE=3
local HEIGHT=3
local ANGLEX=-30

local COLOR=Color3.new(0,0,0)

local RADIUS=6.5
local SEGMENTS=100
local ROD_LENGTH=13
local BALL_SIZE=2.5
local CENTER_SIZE=2.8

local function part(name,size,shape)
	local p=Instance.new("Part")
	p.Name=name
	p.Size=size
	p.Anchored=true
	p.CanCollide=false
	p.Material=Enum.Material.Neon
	p.Color=COLOR
	p.CastShadow=false
	if shape then p.Shape=shape end
	p.Parent=folder

	local glow=Instance.new("PointLight")
	glow.Brightness=1
	glow.Range=10
	glow.Color=COLOR
	glow.Parent=p

	return p
end

local function createWheel(char)
	folder:ClearAllChildren()

	local root=char:WaitForChild("HumanoidRootPart")

	local center=part(
		"Center",
		Vector3.new(
			CENTER_SIZE*SCALE,
			CENTER_SIZE*SCALE,
			CENTER_SIZE*SCALE
		),
		Enum.PartType.Ball
	)

	local ring={}

	for i=1,SEGMENTS do
		ring[i]=part(
			"Ring",
			Vector3.new(.2,.45,.35)
		)
	end

	local rods={}
	local balls={}

	for i=1,8 do
		rods[i]=part(
			"Spoke",
			Vector3.new(
				.45*SCALE,
				ROD_LENGTH*SCALE,
				.45*SCALE
			)
		)

		balls[i]=part(
			"Ball",
			Vector3.new(
				BALL_SIZE*SCALE,
				BALL_SIZE*SCALE,
				BALL_SIZE*SCALE
			),
			Enum.PartType.Ball
		)
	end

	local spin=0

	RunService.RenderStepped:Connect(function(dt)

		if not char.Parent then return end

		root=char:FindFirstChild("HumanoidRootPart")
		if not root then return end

		spin+=dt*0.6

		local radius=RADIUS*SCALE

		local pos=
			root.Position
			-root.CFrame.LookVector*DISTANCE
			+root.CFrame.UpVector*HEIGHT

		local cf=
			CFrame.lookAt(
				pos,
				pos+root.CFrame.LookVector
			)
			*CFrame.Angles(
				math.rad(ANGLEX),
				0,
				0
			)

		center.CFrame=cf

		for i,v in ipairs(ring) do
			local a=(math.pi*2/SEGMENTS)*i

			v.CFrame=
				cf
				*CFrame.new(
					math.cos(a)*radius,
					math.sin(a)*radius,
					0
				)
				*CFrame.Angles(0,0,a)
		end

		for i=1,8 do
			local a=(math.pi*2/8)*i+spin

			rods[i].CFrame=
				cf
				*CFrame.Angles(
					0,
					0,
					a
				)

			balls[i].CFrame=
				cf
				*CFrame.new(
					math.cos(a)*radius*1.45,
					math.sin(a)*radius*1.45,
					0
				)
		end
	end)
end

player.CharacterAdded:Connect(function(char)
	task.wait(1)
	createWheel(char)
end)

if player.Character then
	createWheel(player.Character)
end
