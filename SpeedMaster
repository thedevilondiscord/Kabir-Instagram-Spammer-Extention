function ResolvePrivateRecipient(prefix)
    prefix = tostring(prefix or "")
    if prefix == "" then return nil end
    local needle = string.lower(string.sub(prefix, 1, 8))

    -- Prefer players currently present in this server.
    for _, player in ipairs(Players:GetPlayers()) do
        local displayName = player.DisplayName or player.Name or ""
        if string.lower(string.sub(displayName, 1, 8)) == needle then
            return player.Name, displayName
        end
    end

    -- Fall back to people whose messages are already known to this client.
    local caches = { GlobalCachedMessages, ServerCachedMessages }
    for _, cache in ipairs(caches) do
        for _, msg in pairs(cache) do
            if type(msg) == "table" then
                local displayName = msg.DisplayName or msg.Username or ""
                if string.lower(string.sub(displayName, 1, 8)) == needle then
                    return msg.Username, displayName
                end
            end
        end
    end

    return nil
end

