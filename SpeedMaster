function PollMessages()
    while true do
        FetchRemoteRankStyles()
        FetchRemoteRoles()

        local globalData = HttpRequest(GLOBAL_MESSAGES_ENDPOINT, "GET")
        if globalData and type(globalData) == "table" then
            for id, msg in pairs(globalData) do
                if type(msg) == "table" and msg.MuteAction then
                    if tonumber(msg.ExpiresAt or 0) > os.time() and msg.TargetUsername and msg.Scope == "GLOBAL" then
                        Moderation.ActiveMutes[Moderation.GetMuteKey("GLOBAL", msg.TargetUsername)] = msg
                    end
                elseif type(msg) == "table" and msg.Timestamp and msg.Timestamp >= ScriptStartTime and (not msg.IsPrivate or msg.Username == LocalPlayer.Name or msg.TargetUsername == LocalPlayer.Name) then
                    local blockedByMute = Moderation.GetActiveMute("GLOBAL", msg.Username) ~= nil
                    if blockedByMute and msg.Username ~= LocalPlayer.Name then
                        -- Muted users' messages are not rendered by clients while the mute is active.
                    else
                    local clientKey = msg.ClientMessageId and ("local_" .. tostring(msg.ClientMessageId)) or nil
                    if clientKey and GlobalCachedMessages[clientKey] then
                        GlobalCachedMessages[id] = msg
                    elseif not GlobalCachedMessages[id] then
                        GlobalCachedMessages[id] = msg
                        local card = CreateMessageCard(msg, true)
                        card.Visible = (ActiveTab == "GLOBAL")
                        table.insert(GlobalUIElements, card)
                        DisplayNewMessageNotif(msg)
                    end
                    end
                end
            end
        end

        local serverData = HttpRequest(SERVER_MESSAGES_ENDPOINT, "GET")
        if serverData and type(serverData) == "table" then
            for id, msg in pairs(serverData) do
                if type(msg) == "table" and msg.JoinEventId == JoinEventId then
                    -- Already rendered locally.
                elseif type(msg) == "table" and msg.MuteAction then
                    if tonumber(msg.ExpiresAt or 0) > os.time() and msg.TargetUsername and msg.Scope == "SERVER" then
                        Moderation.ActiveMutes[Moderation.GetMuteKey("SERVER", msg.TargetUsername)] = msg
                    end
                elseif type(msg) == "table" and msg.Timestamp and msg.Timestamp >= ScriptStartTime and (not msg.IsPrivate or msg.Username == LocalPlayer.Name or msg.TargetUsername == LocalPlayer.Name) then
                    local blockedByMute = Moderation.GetActiveMute("SERVER", msg.Username) ~= nil
                    if blockedByMute and msg.Username ~= LocalPlayer.Name then
                        -- Muted users' messages are not rendered by clients while the mute is active.
                    else
                    local clientKey = msg.ClientMessageId and ("local_" .. tostring(msg.ClientMessageId)) or nil
                    if clientKey and ServerCachedMessages[clientKey] then
                        ServerCachedMessages[id] = msg
                    elseif not ServerCachedMessages[id] then
                        ServerCachedMessages[id] = msg
                        local card = CreateMessageCard(msg, false)
                        card.Visible = (ActiveTab == "SERVER")
                        table.insert(ServerUIElements, card)
                        DisplayNewMessageNotif(msg)
                    end
                    end
                end
            end
        end

        task.wait(2)
    end
end

