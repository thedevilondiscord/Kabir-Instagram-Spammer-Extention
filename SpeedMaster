local function AnimateRainbowText(textObject)
    if not textObject then return end
    task.spawn(function()
        local hue = 0
        while textObject and textObject.Parent do
            hue = (hue + 0.008) % 1
            textObject.TextColor3 = Color3.fromHSV(hue, 0.9, 1)
            task.wait(0.03)
        end
    end)
end

