local function SendServerInvite()
    if ActiveTab ~= "GLOBAL" then return end

    local clientMessageId = LocalPlayer.UserId .. "_invite_" ..
        tostring(math.floor(os.clock() * 1000000)) .. "_" ..
        tostring(math.random(100000, 999999))

    local payload = {
        ClientMessageId = clientMessageId,
        Username = LocalPlayer.Name,
        DisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
        Text = "invited you to join their current server",
        Timestamp = os.time(),
        Role = GetAssignedOrCalculatedRole(LocalPlayer.Name),
        PfpId = CurrentPfpId,
        IsPrivate = false,
        IsServerInvite = true,
        PlaceId = game.PlaceId,
        JobId = SERVER_JOB_ID,
    }

    local localKey = "local_" .. clientMessageId
    GlobalCachedMessages[localKey] = payload

    local immediateCard = CreateMessageCard(payload, true)
    immediateCard.Visible = true
    table.insert(GlobalUIElements, immediateCard)

    task.spawn(function()
        pcall(function()
            HttpRequest(GLOBAL_MESSAGES_ENDPOINT, "POST", payload)
        end)
    end)
end

