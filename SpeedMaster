local function NormalizeMusicDatabase(data)
    if type(data) ~= "table" then return nil end
    local normalized = {}
    local found = false
    for category, songs in pairs(data) do
        if type(songs) == "table" then
            normalized[tostring(category)] = {}
            for _, song in ipairs(songs) do
                if type(song) == "table" and song.id and song.name then
                    table.insert(normalized[tostring(category)], {
                        id = tostring(song.id),
                        name = tostring(song.name),
                    })
                    found = true
                end
            end
        end
    end
    return found and normalized or nil
end

local function LoadMusicDatabase()
    task.spawn(function()
        local remote = HttpRequest(MUSIC_DB_URL, "GET")
        local normalized = NormalizeMusicDatabase(remote)
        if normalized then
            MusicDatabase = normalized
            MusicDatabaseLoaded = true
            if MusicUIRefresh then pcall(MusicUIRefresh) end
        end
    end)
end

local function GenerateMusicSessionId()
    return string.upper(string.format("%06d", math.random(0, 999999)))
end

local function MusicSessionUrl(sessionId, suffix)
    return MUSIC_SESSION_FIREBASE_URL .. tostring(sessionId) .. (suffix or "") .. ".json"
end

local function IsMusicSessionHost()
    return MusicSessionData ~= nil and tonumber(MusicSessionData.HostUserId) == tonumber(LocalPlayer.UserId)
end

local function StopMusicPlayback()
    if MusicSound then
        pcall(function() MusicSound:Stop() end)
    end
    MusicCurrentNonce = nil
end

local function EnsureMusicSound()
    if MusicSound and MusicSound.Parent then return MusicSound end
    local SoundService = game:GetService("SoundService")
    MusicSound = Instance.new("Sound")
    MusicSound.Name = "KronosMusicSessionPlayer"
    MusicSound.Volume = MusicMuted and 0 or 0.5
    MusicSound.Looped = false
    MusicSound.Parent = SoundService
    return MusicSound
end

local function PlayMusicLocally(songId, startedAt, nonce)
    local sound = EnsureMusicSound()
    local numericId = tostring(songId or ""):match("%d+")
    if not numericId or numericId == "" then return end

    MusicCurrentNonce = nonce
    sound.Volume = MusicMuted and 0 or 0.5
    sound.SoundId = "rbxassetid://" .. numericId
    pcall(function() sound:Stop() end)
    pcall(function() sound.TimePosition = 0 end)
    pcall(function() sound:Play() end)

    -- Compensate for Firebase polling/network delay when Roblox exposes the
    -- audio length. This is best-effort and never blocks playback indefinitely.
    if tonumber(startedAt) then
        task.spawn(function()
            local deadline = os.clock() + 4
            while sound.Parent and not sound.IsLoaded and os.clock() < deadline do
                task.wait(0.1)
            end
            if sound.Parent and sound.IsLoaded and sound.TimeLength > 0 and MusicCurrentNonce == nonce then
                local elapsed = math.max(0, os.time() - tonumber(startedAt))
                if elapsed < sound.TimeLength then
                    pcall(function() sound.TimePosition = elapsed end)
                end
            end
        end)
    end
end

local function PushMusicSessionState(state)
    if not MusicSessionId or not IsMusicSessionHost() then return false end
    state = state or MusicSessionData or {}
    state.HostUserId = LocalPlayer.UserId
    state.HostUsername = LocalPlayer.Name
    state.HostDisplayName = LocalPlayer.DisplayName
    state.LastHeartbeat = os.time()
    MusicSessionData = state
    local response = HttpRequest(MusicSessionUrl(MusicSessionId), "PUT", state)
    return response ~= nil
end

local function WriteMusicMemberPresence(joined)
    if not MusicSessionId then return end
    local url = MusicSessionUrl(MusicSessionId, "/members/" .. tostring(LocalPlayer.UserId))
    if joined then
        HttpRequest(url, "PUT", {
            UserId = LocalPlayer.UserId,
            Username = LocalPlayer.Name,
            DisplayName = LocalPlayer.DisplayName,
            JoinedAt = os.time(),
            LastSeen = os.time(),
        })
    else
        HttpRequest(url, "DELETE")
    end
end

local function LeaveMusicSession(showMessage)
    if not MusicSessionId then return end
    local oldId = MusicSessionId
    local wasHost = IsMusicSessionHost()
    WriteMusicMemberPresence(false)
    if wasHost then
        -- Deleting the session makes the session ID immediately invalid for new joins.
        HttpRequest(MusicSessionUrl(oldId), "DELETE")
    end
    MusicSessionId = nil
    MusicSessionData = nil
    MusicCurrentNonce = nil
    StopMusicPlayback()
    if MusicStatus then MusicStatus.Text = "No music session joined." end
    if MusicUIRefresh then pcall(MusicUIRefresh) end
    if showMessage and type(ShowLocalSystemMessage) == "function" then
        ShowLocalSystemMessage("[Music Session] You left the session.", false)
    end
end

JoinMusicSession = function(rawId)
    local id = tostring(rawId or ""):upper():gsub("%s+", "")
    if not id:match("^%d%d%d%d%d%d$") then
        if MusicStatus then MusicStatus.Text = "Invalid session ID. Use the 6-digit code." end
        return false
    end

    local data = HttpRequest(MusicSessionUrl(id), "GET")
    if type(data) ~= "table" or not data.HostUserId then
        if MusicStatus then MusicStatus.Text = "Session not found or expired." end
        return false
    end
    if tonumber(data.LastHeartbeat or data.CreatedAt or 0) > 0 and os.time() - tonumber(data.LastHeartbeat or data.CreatedAt) > MUSIC_SESSION_TTL then
        if MusicStatus then MusicStatus.Text = "That music session has expired." end
        return false
    end

    if MusicSessionId and MusicSessionId ~= id then
        LeaveMusicSession(false)
    end

    MusicSessionId = id
    MusicSessionData = data
    WriteMusicMemberPresence(true)
    if MusicStatus then MusicStatus.Text = "Joined session " .. id .. " • Host: " .. tostring(data.HostDisplayName or data.HostUsername or "Unknown") end
    if MusicUIRefresh then pcall(MusicUIRefresh) end
    if type(ShowLocalSystemMessage) == "function" then
        ShowLocalSystemMessage("[Music Session] Joined " .. id .. " • Host: " .. tostring(data.HostDisplayName or data.HostUsername or "Unknown"), false)
    end
    return true
end

local function CreateMusicSession()
    if MusicSessionId then LeaveMusicSession(false) end

    -- Avoid overwriting an already-live session if the random six-digit code collides.
    local id = nil
    for _ = 1, 8 do
        local candidate = GenerateMusicSessionId()
        local existing = HttpRequest(MusicSessionUrl(candidate), "GET")
        if type(existing) ~= "table" or not existing.HostUserId then
            id = candidate
            break
        end
    end
    if not id then
        if MusicStatus then MusicStatus.Text = "Could not allocate a unique session ID. Try again." end
        return false
    end

    local state = {
        HostUserId = LocalPlayer.UserId,
        HostUsername = LocalPlayer.Name,
        HostDisplayName = LocalPlayer.DisplayName,
        CreatedAt = os.time(),
        LastHeartbeat = os.time(),
        Current = nil,
        Queue = {},
        Nonce = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999)),
    }
    local result = HttpRequest(MusicSessionUrl(id), "PUT", state)
    if result == nil then
        if MusicStatus then MusicStatus.Text = "Could not create session (HTTP unavailable)." end
        return false
    end
    MusicSessionId = id
    MusicSessionData = state
    MusicMuted = false
    EnsureMusicSound().Volume = 0.5
    WriteMusicMemberPresence(true)
    if MusicStatus then MusicStatus.Text = "HOSTING " .. id .. " • Only you can control playback." end
    if MusicUIRefresh then pcall(MusicUIRefresh) end
    if type(ShowLocalSystemMessage) == "function" then
        ShowLocalSystemMessage("[Music Session] Created session " .. id .. ". You are the host.", false)
    end
    return true
end

local function HostPlaySong(songName, songId, fromQueue)
    if not IsMusicSessionHost() then
        if MusicStatus then MusicStatus.Text = "Only the session host can play music." end
        return false
    end
    local id = tostring(songId or ""):match("%d+")
    if not id then return false end
    local name = tostring(songName or ("Music ID " .. id))
    local nonce = tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
    MusicSessionData.Current = {
        Id = id,
        Name = name,
        StartedAt = os.time(),
        Nonce = nonce,
    }
    if fromQueue then
        MusicSessionData.Queue = MusicSessionData.Queue or {}
    end
    local synced = PushMusicSessionState(MusicSessionData)
    PlayMusicLocally(id, MusicSessionData.Current.StartedAt, nonce)
    if MusicStatus then
        MusicStatus.Text = synced and ("▶ " .. name .. " [" .. id .. "]") or ("▶ " .. name .. " [" .. id .. "] • sync failed")
    end
    if MusicUIRefresh then pcall(MusicUIRefresh) end
    return true
end

local function HostQueueSong(songName, songId)
    if not IsMusicSessionHost() then
        if MusicStatus then MusicStatus.Text = "Only the session host can edit the queue." end
        return false
    end
    local id = tostring(songId or ""):match("%d+")
    if not id then return false end
    MusicSessionData.Queue = MusicSessionData.Queue or {}
    table.insert(MusicSessionData.Queue, {Name = tostring(songName or ("Music ID " .. id)), Id = id})
    PushMusicSessionState(MusicSessionData)
    if MusicStatus then MusicStatus.Text = "Queued: " .. tostring(songName or id) end
    if MusicUIRefresh then pcall(MusicUIRefresh) end
    return true
end

local function HostPlayNext()
    if not IsMusicSessionHost() then return end
    local queue = MusicSessionData and MusicSessionData.Queue or {}
    if #queue == 0 then
        MusicSessionData.Current = nil
        PushMusicSessionState(MusicSessionData)
        StopMusicPlayback()
        if MusicStatus then MusicStatus.Text = "Queue finished." end
        if MusicUIRefresh then pcall(MusicUIRefresh) end
        return
    end
    local nextSong = table.remove(queue, 1)
    MusicSessionData.Queue = queue
    HostPlaySong(nextSong.Name, nextSong.Id, true)
end

local function InviteMusicSession(scope)
    if not MusicSessionId then
        if MusicStatus then MusicStatus.Text = "Create or join a music session first." end
        return
    end
    local endpoint = scope == "SERVER" and SERVER_MESSAGES_ENDPOINT or GLOBAL_MESSAGES_ENDPOINT
    local payload = {
        ClientMessageId = LocalPlayer.UserId .. "_musicinvite_" .. tostring(math.floor(os.clock() * 1000000)) .. "_" .. tostring(math.random(100000, 999999)),
        Username = LocalPlayer.Name,
        DisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
        Text = "invited you to join Music Session #" .. MusicSessionId,
        Timestamp = os.time(),
        Role = GetAssignedOrCalculatedRole(LocalPlayer.Name),
        PfpId = CurrentPfpId,
        IsPrivate = false,
        IsMusicInvite = true,
        MusicSessionId = MusicSessionId,
        MusicHostUserId = LocalPlayer.UserId,
        MusicHostDisplayName = LocalPlayer.DisplayName,
    }
    task.spawn(function()
        HttpRequest(endpoint, "POST", payload)
    end)
    if MusicStatus then MusicStatus.Text = "Invite sent to " .. string.upper(scope) .. " chat." end
end

