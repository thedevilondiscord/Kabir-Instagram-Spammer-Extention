-- ROLE/TAG FONT ANIMATION
-- The entire role-name font smoothly transitions between its assigned colours.
-- The profile below is intentionally separate from remotely-fetched rank styles
-- so these animation preferences cannot be overwritten by remote style refreshes.
-- ============================================================================
-- Legacy role animation profiles removed: each actual rank uses its local Speed; cosmetic roles use NoAnimation.


local function AnimateRoleFont(textObject, roleName, style)
    if not textObject or not textObject.Parent then return end
    style = style or RANK_STYLES[roleName] or RANK_STYLES["VIP"]
    if style.NoAnimation then
        textObject.TextColor3 = style.Name or style.Start
        return
    end

    local duration = tonumber(style.Speed) or 1.2
    local startColor = style.Start or style.Name or Color3.new(1,1,1)
    local endColor = style.End or startColor
    textObject.TextColor3 = startColor

    task.spawn(function()
        while textObject and textObject.Parent do
            local toEnd = TweenService:Create(textObject, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextColor3 = endColor})
            toEnd:Play()
            toEnd.Completed:Wait()
            if not textObject or not textObject.Parent then break end
            local toStart = TweenService:Create(textObject, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {TextColor3 = startColor})
            toStart:Play()
            toStart.Completed:Wait()
        end
    end)
end

