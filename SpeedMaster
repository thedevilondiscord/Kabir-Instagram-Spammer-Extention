-- Refresh the listener's local playback whenever the host changes the session state.
task.spawn(function()
    while true do
        if MusicSessionId then
            local data = HttpRequest(MusicSessionUrl(MusicSessionId), "GET")
            if type(data) == "table" and data.HostUserId then
                MusicSessionData = data
                local stale = tonumber(data.LastHeartbeat or data.CreatedAt or 0) > 0 and (os.time() - tonumber(data.LastHeartbeat or data.CreatedAt)) > MUSIC_SESSION_TTL
                if stale then
                    local old = MusicSessionId
                    MusicSessionId = nil
                    MusicSessionData = nil
                    StopMusicPlayback()
                    if MusicStatus then MusicStatus.Text = "Session " .. old .. " expired." end
                else
                    if IsMusicSessionHost() then
                        if tonumber(data.LastHeartbeat or 0) <= os.time() - MUSIC_HEARTBEAT_INTERVAL then
                            data.LastHeartbeat = os.time()
                            MusicSessionData = data
                            PushMusicSessionState(data)
                        end
                    end
                    local current = data.Current
                    local nonce = current and current.Nonce
                    if current and nonce and nonce ~= MusicCurrentNonce then
                        PlayMusicLocally(current.Id, current.StartedAt, nonce)
                        if MusicStatus then MusicStatus.Text = "♫ " .. tostring(current.Name or current.Id) .. " [" .. tostring(current.Id) .. "]" end
                        if not IsMusicSessionHost() and type(ShowLocalSystemMessage) == "function" then
                            ShowLocalSystemMessage("[Music Session] Host started: " .. tostring(current.Name or current.Id) .. " [" .. tostring(current.Id) .. "]", false)
                        end
                    elseif not current and MusicCurrentNonce then
                        StopMusicPlayback()
                    end
                    if MusicUIRefresh then pcall(MusicUIRefresh) end
                end
                WriteMusicMemberPresence(true)
            else
                local old = MusicSessionId
                MusicSessionId = nil
                MusicSessionData = nil
                StopMusicPlayback()
                if MusicStatus then MusicStatus.Text = "Session " .. tostring(old) .. " no longer exists." end
                if MusicUIRefresh then pcall(MusicUIRefresh) end
            end
        end
        task.wait(MUSIC_SESSION_POLL_INTERVAL)
    end
end)

