-- mode indicator/control and the textbox remains a normal editable textbox.
function SetPersistentPrivatePrefix(displayName, username)
    local safeName = tostring(displayName or username or "Unknown")
    PrivateModeTargetUsername = username
    PrivateModeTargetDisplayName = safeName
    PersistentPvtPrefix = "/pvt @" .. string.sub(safeName, 1, 8) .. " "
