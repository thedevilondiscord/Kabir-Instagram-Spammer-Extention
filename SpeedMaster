local function GenerateSessionID()
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local id = ""
    for i = 1, 6 do
        local rand = math.random(1, #chars)
        id = id .. string.sub(chars, rand, rand)
    end
    return id
end

local RenderMusicSessionView = function() end

local function LeaveCurrentMusicSession()
    if MusicSessionState.SessionID then
        local sessionID = MusicSessionState.SessionID
        if MusicSessionState.IsHost then
            HttpRequest(MUSIC_FIREBASE_URL .. "sessions/" .. sessionID .. ".json", "DELETE")
        else
            HttpRequest(MUSIC_FIREBASE_URL .. "sessions/" .. sessionID .. "/members/" .. tostring(LocalPlayer.UserId) .. ".json", "DELETE")
        end
    end

    if MusicSessionState.PollConnection then
        MusicSessionState.PollConnection:Disconnect()
        MusicSessionState.PollConnection = nil
    end

    MusicSessionState.InSession = false
    MusicSessionState.IsHost = false
    MusicSessionState.SessionID = nil
    MusicSessionState.CurrentTrack = nil
    LocalAudioPlayer:Stop()

    RenderMusicSessionView()
end

local function StartSessionPolling()
    if MusicSessionState.PollConnection then
        MusicSessionState.PollConnection:Disconnect()
    end

    MusicSessionState.PollConnection = RunService.Heartbeat:Connect(function()
        -- Throttle polling using a basic tick timer attached to function scope
    end)

    task.spawn(function()
        while MusicSessionState.InSession and MusicSessionState.SessionID do
            local sessionData = HttpRequest(MUSIC_FIREBASE_URL .. "sessions/" .. MusicSessionState.SessionID .. ".json", "GET")
            if not sessionData then
                LeaveCurrentMusicSession()
                break
            end

            if not MusicSessionState.IsHost and sessionData.currentTrack then
                local remoteTrack = sessionData.currentTrack
                if not MusicSessionState.CurrentTrack or MusicSessionState.CurrentTrack.id ~= remoteTrack.id then
                    PlayTrackLocally(remoteTrack)
                end
            end
            task.wait(2)
        end
    end)
end

local function CreateNewMusicSession()
    local newID = GenerateSessionID()
    local sessionData = {
        hostUserId = LocalPlayer.UserId,
        hostName = LocalPlayer.DisplayName,
        currentTrack = { name = "None", id = "", timestamp = os.time() },
        members = { [tostring(LocalPlayer.UserId)] = true }
    }

    local res = HttpRequest(MUSIC_FIREBASE_URL .. "sessions/" .. newID .. ".json", "PUT", sessionData)
    if res then
        MusicSessionState.InSession = true
        MusicSessionState.IsHost = true
        MusicSessionState.SessionID = newID
        MusicSessionState.HostName = LocalPlayer.DisplayName
        StartSessionPolling()
        RenderMusicSessionView()
    end
end

local function JoinMusicSession(sessionID)
    sessionID = string.upper(tostring(sessionID or "")):gsub("%s+", "")
    if string.len(sessionID) ~= 6 then return false, "Invalid Session ID format" end

    local sessionData = HttpRequest(MUSIC_FIREBASE_URL .. "sessions/" .. sessionID .. ".json", "GET")
    if sessionData and sessionData.hostUserId then
        HttpRequest(MUSIC_FIREBASE_URL .. "sessions/" .. sessionID .. "/members/" .. tostring(LocalPlayer.UserId) .. ".json", "PUT", true)
        
        MusicSessionState.InSession = true
        MusicSessionState.IsHost = (tostring(sessionData.hostUserId) == tostring(LocalPlayer.UserId))
        MusicSessionState.SessionID = sessionID
        MusicSessionState.HostName = sessionData.hostName or "Host"
        StartSessionPolling()
        
        if sessionData.currentTrack and sessionData.currentTrack.id ~= "" then
            PlayTrackLocally(sessionData.currentTrack)
        end

        RenderMusicSessionView()
        return true
    else
        return false, "Invalid Session ID"
    end
end

