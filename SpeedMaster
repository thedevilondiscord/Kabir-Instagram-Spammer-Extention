local function PlayTrackLocally(track)
    if not track or not track.id then return end
    MusicSessionState.CurrentTrack = track
    
    LocalAudioPlayer:Stop()
    LocalAudioPlayer.SoundId = "rbxassetid://" .. tostring(track.id)
    if not MusicSessionState.Muted then
        LocalAudioPlayer.Volume = 1
    else
        LocalAudioPlayer.Volume = 0
    end
    LocalAudioPlayer:Play()

    DisplayLocalSystemMessage("[Music Session] Now playing: " .. tostring(track.name or "Track"))
end

