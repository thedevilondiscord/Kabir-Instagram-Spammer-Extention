local function SetChatVisibility(show)
    if ChatTransitionBusy then return end
    ChatTransitionBusy = true

    if show then
        ChatIsShown = true
        MainFrame.Visible = true
        MainFrame.Position = ChatHiddenPosition
        MainScale.Scale = 0.72

        local move = TweenService:Create(
            MainFrame,
            TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {Position = ChatOriginalPosition}
        )
        local scale = TweenService:Create(
            MainScale,
            TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Scale = 1}
        )
        move:Play()
        scale:Play()
        move.Completed:Wait()
        ToggleButton.Text = "  👁️  KRONOS"
    else
        ChatIsShown = false

        local move = TweenService:Create(
            MainFrame,
            TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
            {Position = ChatHiddenPosition}
        )
        local scale = TweenService:Create(
            MainScale,
            TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
            {Scale = 0.72}
        )
        move:Play()
        scale:Play()
        move.Completed:Wait()

        if not ChatIsShown then
            MainFrame.Visible = false
        end
        ToggleButton.Text = "  ⭕  KRONOS"
    end

    ChatTransitionBusy = false
end

