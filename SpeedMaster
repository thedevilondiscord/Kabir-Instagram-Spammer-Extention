local function AnimateRoleFont(textObject, roleName, style)
    if not textObject or not textObject.Parent then return end
    style = style or RANK_STYLES[roleName] or RANK_STYLES["VIP"]

    local oldGradient = textObject:FindFirstChild("KronosRoleGradient")
    if oldGradient then oldGradient:Destroy() end

    local mode = style.Mode or "FONT_LOOP"
    local duration = tonumber(style.Speed) or 1.0
    local startColor = style.Start or style.Name or Color3.new(1, 1, 1)
    local endColor = style.End or Color3.new(0, 0, 0)

    if mode == "RAINBOW_WHITE" then
        local gradient = Instance.new("UIGradient")
        gradient.Name = "KronosRoleGradient"
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255, 0, 180)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(70, 0, 255)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 220, 255)),
            ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 255, 90)),
            ColorSequenceKeypoint.new(0.82, Color3.fromRGB(255, 240, 0)),
            ColorSequenceKeypoint.new(0.93, Color3.fromRGB(255, 70, 0)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 255, 255)),
        })
        gradient.Rotation = 0
        gradient.Parent = textObject

        task.spawn(function()
            local offset = -1
            while textObject and textObject.Parent and gradient and gradient.Parent do
                local tween = TweenService:Create(
                    gradient,
                    TweenInfo.new(duration * 2.0, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
                    {Offset = Vector2.new(2, 0)}
                )
                gradient.Offset = Vector2.new(offset, 0)
                tween:Play()
                tween.Completed:Wait()
                offset = -1
            end
        end)
        return
    end

    if mode == "PRIMARY_SECONDARY" then
        local gradient = Instance.new("UIGradient")
        gradient.Name = "KronosRoleGradient"
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, startColor),
            ColorSequenceKeypoint.new(0.50, endColor),
            ColorSequenceKeypoint.new(1.00, startColor),
        })
        gradient.Rotation = 0
        gradient.Parent = textObject

        task.spawn(function()
            while textObject and textObject.Parent and gradient and gradient.Parent do
                gradient.Offset = Vector2.new(-1, 0)
                local tween = TweenService:Create(
                    gradient,
                    TweenInfo.new(duration * 2.0, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
                    {Offset = Vector2.new(1, 0)}
                )
                tween:Play()
                tween.Completed:Wait()
            end
        end)
        return
    end

    textObject.TextColor3 = startColor
    task.spawn(function()
        while textObject and textObject.Parent do
            local toBlack = TweenService:Create(
                textObject,
                TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                {TextColor3 = endColor}
            )
            toBlack:Play()
            toBlack.Completed:Wait()
            if not textObject or not textObject.Parent then break end

            local toStart = TweenService:Create(
                textObject,
                TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                {TextColor3 = startColor}
            )
            toStart:Play()
            toStart.Completed:Wait()
        end
    end)
end

