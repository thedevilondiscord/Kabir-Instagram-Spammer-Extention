-- LocalScript inside StarterPlayerScripts / StarterGui (Kronos Chat Bubble Addon)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local SERVER_JOB_ID = game.JobId ~= "" and game.JobId or "Studio_Local_Server"
local KRONOS_FIREBASE_URL = "https://gcserverchat-default-rtdb.asia-southeast1.firebasedatabase.app/"
local KRONOS_MESSAGES_ENDPOINT = KRONOS_FIREBASE_URL .. "server_chat/" .. SERVER_JOB_ID .. ".json"

-- Multi-executor Compatible HTTP Request Handler
local http_req = (syn and syn.request) or (http and http.request) or http_request or request or (Fluxus and fluxus.request)

local function HttpRequest(url, method, data)
    if not http_req then return nil end
    local success, response = pcall(function()
        return http_req({
            Url = url,
            Method = method or "GET",
            Headers = { ["Content-Type"] = "application/json" },
            Body = data and HttpService:JSONEncode(data) or nil
        })
    end)

    if success and response and response.Body and response.Body ~= "null" then
        local decodedSuccess, decodedData = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        return decodedSuccess and decodedData or nil
    end
    return nil
end

-- ============================================================================
-- CUSTOM MATHEMATICAL FONT MAPPER
-- ============================================================================
local standardChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
local customChars   = "αв¢∂єƒgнιנкℓмησρqяѕтυνωχуzαв¢∂єƒgнιנкℓмησρqяѕтυвωχуz"
local capsChars     = "ᴀʙᴄᴅᴇꜰɢʜɪᴊᴋʟᴍɴᴏᴘQʀꜱᴛᴜᴠᴡxʏᴢᴀʙᴄᴅᴇꜰɢʜɪᴊᴋʟᴍɴᴏᴘQʀꜱᴛᴜʙᴡxʏᴢ"

local fontMap = {}

for i = 1, 26 do
    local src = string.sub(standardChars, i, i)
    local target = string.sub(customChars, (i-1)*3 + 1, i*3)
    fontMap[src] = target
end

for i = 27, 52 do
    local src = string.sub(standardChars, i, i)
    local idx = i - 26
    local target = string.sub(capsChars, (idx-1)*3 + 1, idx*3)
    fontMap[src] = target
end

local function ConvertToCustomFont(str)
    if not str then return "" end
    local converted = ""
    for i = 1, #str do
        local char = string.sub(str, i, i)
        if fontMap[char] then
            converted = converted .. fontMap[char]
        else
            converted = converted .. char
        end
    end
    return converted
end

-- ============================================================================
-- KRONOS OVERHEAD BUBBLE MANAGER
-- ============================================================================
local ActivePlayerBubbles = {}

local function GetCharacterHead(player)
    if not player then return nil end
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("Head", 5) or char:WaitForChild("HumanoidRootPart", 5)
end

local function CreateKronosBubble(player, rawText)
    local head = GetCharacterHead(player)
    if not head then return end

    if not ActivePlayerBubbles[player] then
        ActivePlayerBubbles[player] = {}
    end

    local stack = ActivePlayerBubbles[player]

    -- Main BillboardGui
    local bbGui = Instance.new("BillboardGui")
    bbGui.Name = "KronosGlassBubble"
    bbGui.Adornee = head
    bbGui.Size = UDim2.new(0, 200, 0, 50)
    bbGui.StudsOffset = Vector3.new(0, 2.8, 0)
    bbGui.AlwaysOnTop = true
    bbGui.ResetOnSpawn = false

    -- Glassmorphic Background Frame
    local bubbleFrame = Instance.new("Frame")
    bubbleFrame.Name = "BubbleFrame"
    bubbleFrame.Size = UDim2.new(1, 0, 1, 0)
    bubbleFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    bubbleFrame.BackgroundTransparency = 0.35
    bubbleFrame.BorderSizePixel = 0
    bubbleFrame.Parent = bbGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = bubbleFrame

    -- Glass Gloss Highlight
    local gloss = Instance.new("Frame")
    gloss.Size = UDim2.new(1, 0, 0.45, 0)
    gloss.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    gloss.BackgroundTransparency = 0.92
    gloss.BorderSizePixel = 0
    gloss.Parent = bubbleFrame

    local glossCorner = Instance.new("UICorner")
    glossCorner.CornerRadius = UDim.new(0, 12)
    glossCorner.Parent = gloss

    -- Animated Red-to-Black Border Gradient
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2.5
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Transparency = 0.1
    stroke.Parent = bubbleFrame

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(10, 0, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
    })
    gradient.Parent = stroke

    local borderConn
    borderConn = RunService.RenderStepped:Connect(function(dt)
        if not stroke or not stroke.Parent then
            if borderConn then borderConn:Disconnect() end
            return
        end
        gradient.Rotation = (gradient.Rotation + (120 * dt)) % 360
    end)

    -- Custom Math Font Label
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -16, 1, -12)
    msgLabel.Position = UDim2.new(0, 8, 0, 6)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Font = Enum.Font.SourceSansBold
    msgLabel.Text = ConvertToCustomFont(rawText)
    msgLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    msgLabel.TextSize = 14
    msgLabel.TextWrapped = true
    msgLabel.TextScaled = false
    msgLabel.Parent = bubbleFrame

    -- Speech Tip
    local pointer = Instance.new("Frame")
    pointer.Size = UDim2.new(0, 10, 0, 10)
    pointer.Position = UDim2.new(0.5, -5, 1, -4)
    pointer.Rotation = 45
    pointer.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    pointer.BackgroundTransparency = 0.35
    pointer.BorderSizePixel = 0
    pointer.ZIndex = 0
    pointer.Parent = bubbleFrame

    -- Auto-Size Calculation
    local textBounds = msgLabel.TextBounds
    local newWidth = math.clamp(textBounds.X + 24, 80, 260)
    local newHeight = math.clamp(textBounds.Y + 18, 40, 120)
    bbGui.Size = UDim2.new(0, newWidth, 0, newHeight)

    bbGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    -- Move older active bubbles up smoothly
    for _, item in ipairs(stack) do
        if item.Gui and item.Gui.Parent then
            local currentOffset = item.Gui.StudsOffset
            TweenService:Create(item.Gui, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                StudsOffset = currentOffset + Vector3.new(0, (newHeight / 20) + 0.4, 0)
            }):Play()
        end
    end

    table.insert(stack, { Gui = bbGui, Stroke = stroke, Label = msgLabel, Frame = bubbleFrame })

    -- 7-Second Auto Fade & Destroy
    task.delay(7, function()
        if bbGui and bbGui.Parent then
            local fadeInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(bubbleFrame, fadeInfo, { BackgroundTransparency = 1 }):Play()
            TweenService:Create(gloss, fadeInfo, { BackgroundTransparency = 1 }):Play()
            TweenService:Create(pointer, fadeInfo, { BackgroundTransparency = 1 }):Play()
            TweenService:Create(msgLabel, fadeInfo, { TextTransparency = 1 }):Play()
            local strokeFade = TweenService:Create(stroke, fadeInfo, { Transparency = 1 })
            strokeFade:Play()

            strokeFade.Completed:Wait()
            bbGui:Destroy()

            for idx, item in ipairs(stack) do
                if item.Gui == bbGui then
                    table.remove(stack, idx)
                    break
                end
            end
        end
    end)
end

-- ============================================================================
-- KRONOS REALTIME LISTENER
-- ============================================================================
local ProcessedMessageIds = {}
local ListenStartTime = os.time()

task.spawn(function()
    while true do
        task.wait(0.1)
        local serverData = HttpRequest(KRONOS_MESSAGES_ENDPOINT, "GET")
        if serverData and type(serverData) == "table" then
            for msgId, msgObj in pairs(serverData) do
                if type(msgObj) == "table" and not ProcessedMessageIds[msgId] then
                    ProcessedMessageIds[msgId] = true

                    local msgTime = msgObj.Timestamp or 0
                    local senderName = msgObj.Username
                    local rawText = msgObj.Text

                    if msgTime >= ListenStartTime and senderName and rawText and not msgObj.IsJoinMessage then
                        local targetPlayer = Players:FindFirstChild(senderName)
                        if targetPlayer and targetPlayer ~= LocalPlayer then
                            if string.sub(rawText, 1, 11) ~= "rbxthumb://" and string.sub(rawText, 1, 13) ~= "rbxassetid://" then
                                CreateKronosBubble(targetPlayer, rawText)
                            end
                        end
                    end
                end
            end
        end
    end
end)
