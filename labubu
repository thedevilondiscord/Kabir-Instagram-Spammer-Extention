-- ============================================================
-- CUSTOM UNICODE FONT
-- ============================================================

local LOWER_FONT =
    "αв¢∂єƒgнιנкℓмησρqяѕтυνωχуz"

local UPPER_FONT =
    "ᴀʙᴄᴅᴇꜰɢʜɪᴊᴋʟᴍɴᴏᴘQʀꜱᴛᴜᴠᴡxʏᴢ"

local LOWER_MAP = {}
local UPPER_MAP = {}

for i = 1, 26 do
    LOWER_MAP[string.char(96 + i)] =
        string.sub(LOWER_FONT, i, i)
end

for i = 1, 26 do
    UPPER_MAP[string.char(64 + i)] =
        string.sub(UPPER_FONT, i, i)
end

local function StylizeText(text)
    text = tostring(text or "")

    local output = {}

    for i = 1, #text do
        local char = string.sub(text, i, i)

        if LOWER_MAP[char] then
            table.insert(output, LOWER_MAP[char])

        elseif UPPER_MAP[char] then
            table.insert(output, UPPER_MAP[char])

        else
            table.insert(output, char)
        end
    end

    return table.concat(output)
end

-- ============================================================
-- EXECUTOR HTTP REQUEST
-- ============================================================

local http_req =
    (syn and syn.request)
    or (http and http.request)
    or http_request
    or request
    or (Fluxus and fluxus.request)

local function HttpRequest(url, method, data)

    if not http_req then
        return nil
    end

    local success, response = pcall(function()

        return http_req({
            Url = url,

            Method = method or "GET",

            Headers = {
                ["Content-Type"] = "application/json"
            },

            Body = data
                and HttpService:JSONEncode(data)
                or nil
        })

    end)

    if not success then
        return nil
    end

    if not response then
        return nil
    end

    if not response.Body then
        return nil
    end

    local decodeSuccess, decoded =
        pcall(function()
            return HttpService:JSONDecode(
                response.Body
            )
        end)

    if decodeSuccess then
        return decoded
    end

    return nil
end

