    tagLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    tagLabel.BackgroundTransparency = 0.3
    tagLabel.Font = Enum.Font.GothamBold
    tagLabel.Text = "  " .. string.upper(roleName) .. "  "
    tagLabel.TextColor3 = style.Start
    tagLabel.TextSize = 9
    tagLabel.Visible = not DisabledTags[msgData.Username]
    tagLabel.Parent = frame

    local tagCorner = Instance.new("UICorner")
    tagCorner.CornerRadius = UDim.new(0, 4)
    tagCorner.Parent = tagLabel

    local tagGradient = Instance.new("UIGradient")
    tagGradient.Color = ColorSequence.new(style.Start, style.End)
    tagGradient.Parent = tagLabel

    local isClient = (msgData.Username == LocalPlayer.Name)
    local formattedName = GetFormattedDisplayName(msgData.DisplayName or msgData.Username, isClient)

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.AutomaticSize = Enum.AutomaticSize.X
    nameLabel.Size = UDim2.new(0, 0, 0, 18)
    nameLabel.Position = tagLabel.Visible and UDim2.new(0, tagLabel.AbsoluteSize.X + 44, 0, 5) or UDim2.new(0, 38, 0, 5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Text = formattedName .. ":"
    nameLabel.TextColor3 = style.Name
    nameLabel.TextSize = 11
    nameLabel.Parent = frame

    tagLabel:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if tagLabel.Visible then
            nameLabel.Position = UDim2.new(0, tagLabel.AbsoluteSize.X + 44, 0, 5)
        else
            nameLabel.Position = UDim2.new(0, 38, 0, 5)
        end
    end)

    local isSticker = string.sub(msgData.Text, 1, 11) == "rbxthumb://" or string.sub(msgData.Text, 1, 13) == "rbxassetid://"

    if msgData.IsServerInvite and msgData.PlaceId and msgData.JobId then
        frame.Size = UDim2.new(1, 0, 0, 88)
        frame.AutomaticSize = Enum.AutomaticSize.None

        local inviteTitle = Instance.new("TextLabel")
        inviteTitle.Name = "ServerInviteTitle"
        inviteTitle.Size = UDim2.new(1, -155, 0, 22)
        inviteTitle.Position = UDim2.new(0, 38, 0, 27)
        inviteTitle.BackgroundTransparency = 1
        inviteTitle.Font = Enum.Font.GothamBold
        inviteTitle.Text = tostring(msgData.Text or "Join Current Server")
        inviteTitle.TextColor3 = Color3.fromRGB(235, 235, 245)
        inviteTitle.TextSize = 12
        inviteTitle.TextXAlignment = Enum.TextXAlignment.Left
        inviteTitle.TextYAlignment = Enum.TextYAlignment.Center
        inviteTitle.TextWrapped = true
        inviteTitle.Parent = frame

        local inviteLabel = Instance.new("TextLabel")
        inviteLabel.Name = "ServerInviteLabel"
        inviteLabel.Size = UDim2.new(1, -155, 0, 18)
        inviteLabel.Position = UDim2.new(0, 38, 0, 50)
        inviteLabel.BackgroundTransparency = 1
        inviteLabel.Font = Enum.Font.Gotham
        inviteLabel.Text = "Server Invite"
        inviteLabel.TextColor3 = Color3.fromRGB(160, 160, 175)
        inviteLabel.TextSize = 10
        inviteLabel.TextXAlignment = Enum.TextXAlignment.Left
        inviteLabel.Parent = frame

        local joinButton = Instance.new("TextButton")
        joinButton.Name = "JoinServerButton"
        joinButton.Size = UDim2.new(0, 120, 0, 30)
        joinButton.Position = UDim2.new(1, -130, 0.5, -15)
        joinButton.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
        joinButton.BackgroundTransparency = 0.1
        joinButton.BorderSizePixel = 0
        joinButton.Font = Enum.Font.GothamBold
        joinButton.Text = "JOIN SERVER"
        joinButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        joinButton.TextSize = 10
        joinButton.ZIndex = 20
        joinButton.Parent = frame

        local joinCorner = Instance.new("UICorner")
        joinCorner.CornerRadius = UDim.new(0, 7)
        joinCorner.Parent = joinButton

        local joinStroke = Instance.new("UIStroke")
        joinStroke.Thickness = 1
        joinStroke.Color = Color3.fromRGB(255, 90, 90)
        joinStroke.Transparency = 0.35
        joinStroke.Parent = joinButton

        joinButton.MouseButton1Click:Connect(function()
            local placeId = tonumber(msgData.PlaceId)
            local jobId = tostring(msgData.JobId or "")

            if not placeId or jobId == "" then
                joinButton.Text = "INVITE EXPIRED"
                task.delay(1.5, function()
                    if joinButton and joinButton.Parent then
                        joinButton.Text = "JOIN SERVER"
                    end
                end)
                return
            end

            if game.JobId ~= "" and jobId == game.JobId then
                joinButton.Text = "ALREADY HERE"
                task.delay(1.5, function()
                    if joinButton and joinButton.Parent then
                        joinButton.Text = "JOIN SERVER"
                    end
                end)
                return
            end

            joinButton.Text = "JOINING..."
            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
            end)

            if not ok then
                joinButton.Text = "JOIN FAILED"
                task.delay(1.5, function()
                    if joinButton and joinButton.Parent then
                        joinButton.Text = "JOIN SERVER"
                    end
                end)
            end
        end)
    elseif isSticker then
        local stickerImg = Instance.new("ImageLabel")
        stickerImg.Name = "StickerMsg"
        stickerImg.Size = UDim2.new(0, 80, 0, 80)
        stickerImg.Position = UDim2.new(0, 38, 0, 26)
        stickerImg.BackgroundTransparency = 1
        stickerImg.Image = msgData.Text
        stickerImg.ScaleType = Enum.ScaleType.Fit
        stickerImg.Parent = frame

        local pad = Instance.new("UIPadding")
        pad.PaddingBottom = UDim.new(0, 8)
        pad.Parent = frame
    else
        local contentLabel = Instance.new("TextLabel")
        contentLabel.Name = "ContentLabel"
        contentLabel.Size = UDim2.new(1, -48, 0, 0)
        contentLabel.Position = UDim2.new(0, 38, 0, 24)
        contentLabel.AutomaticSize = Enum.AutomaticSize.Y
        contentLabel.BackgroundTransparency = 1
        contentLabel.Font = Enum.Font.Gotham
