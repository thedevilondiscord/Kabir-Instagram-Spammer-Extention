local function CreateServerInvitePayload()
    return {
        Username = LocalPlayer.Name,
        DisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
        Text = "Join " .. GetFormattedDisplayName(LocalPlayer.DisplayName, true) .. "'s Current Server",
        Timestamp = os.time(),
        Role = GetAssignedOrCalculatedRole(LocalPlayer.Name),
        PfpId = CurrentPfpId,
        IsPrivate = false,
        IsServerInvite = true,
        PlaceId = game.PlaceId,
        JobId = SERVER_JOB_ID,
    }
end

local function SendServerInvite()
    if ActiveTab ~= "GLOBAL" then
        return
    end

    if not game.PlaceId or game.PlaceId <= 0 or SERVER_JOB_ID == "" then
        return
    end

    local payload = CreateServerInvitePayload()
    local localId = "local_invite_" .. tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))

    -- Render immediately for the sender.
    GlobalCachedMessages[localId] = payload
    local card = CreateMessageCard(payload, true)
    card.Visible = true
    table.insert(GlobalUIElements, card)

    task.spawn(function()
        HttpRequest(GLOBAL_MESSAGES_ENDPOINT, "POST", payload)
    end)
end

ServerInviteButton.MouseButton1Click:Connect(SendServerInvite)
ServerInviteButton.Visible = (ActiveTab == "GLOBAL")

