    task.spawn(function()

        local rotation = 0

        while animationAlive
            and bubble.Parent
            and stroke.Parent do

            rotation =
                (rotation + 2.4) % 360

            borderGradient.Rotation =
                rotation

            glowGradient.Rotation =
                rotation

            task.wait(0.03)
        end
    end)

    -- ========================================================
    -- REGISTER BUBBLE
    -- ========================================================

    local entry = {

        Id = tostring(messageId),

        Bubble = bubble,

        Created = tick()

    }

    table.insert(
        state.Messages,
        entry
    )

    -- ========================================================
    -- POP-IN
    -- ========================================================

    bubble.BackgroundTransparency = 1

    stroke.Transparency = 1

    glowStroke.Transparency = 1

    label.TextTransparency = 1

    bubble.Size =
        UDim2.new(
            1,
            -28,
            0,
            0
        )

    TweenService:Create(

        bubble,

        TweenInfo.new(
            0.22,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),

        {
            BackgroundTransparency = 0.18,

            Size =
                UDim2.new(
                    1,
                    -18,
                    0,
                    0
                )
        }

    ):Play()

    TweenService:Create(

        stroke,

        TweenInfo.new(0.22),

        {
            Transparency = 0
        }

    ):Play()

    TweenService:Create(

        glowStroke,

        TweenInfo.new(0.22),

        {
            Transparency = 0.72
        }

    ):Play()

    TweenService:Create(

        label,

        TweenInfo.new(0.22),

        {
            TextTransparency = 0
        }

    ):Play()

    -- ========================================================
    -- 7 SECOND TIMER
    -- ========================================================

    task.delay(
        BUBBLE_LIFETIME,
        function()

            if not bubble
                or not bubble.Parent then

                return
            end

            animationAlive = false

            local fadeInfo =
                TweenInfo.new(
                    FADE_TIME,
                    Enum.EasingStyle.Quad,
                    Enum.EasingDirection.Out
                )

            TweenService:Create(

                bubble,

                fadeInfo,

                {
                    BackgroundTransparency = 1
                }

            ):Play()

            TweenService:Create(

                stroke,

                fadeInfo,

                {
                    Transparency = 1
                }

            ):Play()

            TweenService:Create(

                glowStroke,

                fadeInfo,

                {
                    Transparency = 1
                }

            ):Play()

            TweenService:Create(

                label,

                fadeInfo,

                {
                    TextTransparency = 1
                }

            ):Play()

            TweenService:Create(

                highlight,

                fadeInfo,

                {
                    BackgroundTransparency = 1
                }

            ):Play()

            task.wait(FADE_TIME)

            if bubble
                and bubble.Parent then

                bubble:Destroy()

            end

            local currentState =
                BubbleState[player]

            if currentState then

                for i =
                    #currentState.Messages,
                    1,
                    -1 do

                    if currentState.Messages[i].Bubble
                        == bubble then

                        table.remove(
                            currentState.Messages,
                            i
                        )

                        break
                    end
                end
            end
        end
    )
end

-- ============================================================
-- MESSAGE FILTER
-- ============================================================

local function ShouldDisplayMessage(msg)

    if type(msg) ~= "table" then
        return false
    end

    -- Must contain actual text.
    if not msg.Text
        or tostring(msg.Text) == "" then

        return false
    end

    -- Private messages are not server chat.
    if msg.IsPrivate then
        return false
    end

    -- Ignore system messages.
    if msg.SystemMessage then
        return false
    end

    -- Ignore join announcements.
    if msg.IsJoinMessage then
        return false
    end

    -- Must contain sender.
    if not msg.Username
        or tostring(msg.Username) == "" then

        return false
    end

    -- IMPORTANT:
    -- There is NO local-player exclusion here.
    --
    -- Your messages are intentionally allowed.
    --
    -- Example:
    --
    -- if msg.Username == LocalPlayer.Name then
    --     return false
    -- end
    --
    -- That check has deliberately been removed.

    return true
end

-- ============================================================
-- FIND PLAYER IN CURRENT SERVER
-- ============================================================

local function FindServerPlayer(msg)

    if not msg then
        return nil
    end

    -- ========================================================
    -- USERNAME MATCH
    -- ========================================================

    if msg.Username then

        local player =
            Players:FindFirstChild(
                tostring(msg.Username)
            )

        if player then
            return player
        end
    end

    -- ========================================================
    -- USER ID FALLBACK
    -- ========================================================

    if msg.UserId then

        local numericId =
            tonumber(msg.UserId)

        if numericId then

            for _, player
                in ipairs(
                    Players:GetPlayers()
                ) do

                if player.UserId ==
                    numericId then

                    return player
                end
            end
        end
    end

    return nil
end

-- ============================================================
-- MESSAGE ID
-- ============================================================

local function GetMessageId(
    firebaseId,
    msg
)

    if firebaseId then

        return tostring(
            firebaseId
        )
    end

    if msg.ClientMessageId then

        return "client_"
            .. tostring(
                msg.ClientMessageId
            )
    end

    return table.concat({

        tostring(
            msg.Username or ""
        ),

        tostring(
            msg.Timestamp or ""
        ),

        tostring(
            msg.Text or ""
        )

    }, "_")
end

-- ============================================================
-- PROCESS MESSAGE
-- ============================================================

local function ProcessServerMessage(
    firebaseId,
    msg
)

    if not ShouldDisplayMessage(msg) then
        return
    end

    local messageId =
        GetMessageId(
            firebaseId,
            msg
        )

    -- Already displayed.
    if ProcessedMessages[messageId] then
        return
    end

    -- Mark immediately.
    ProcessedMessages[messageId] = true

    -- Find sender in CURRENT Roblox server.
    local player =
        FindServerPlayer(msg)

    -- Firebase can contain stale messages
    -- from users no longer in this server.
    if not player then
        return
    end

    -- Your own message is allowed.
    -- There is intentionally NO:
    --
    -- if player == LocalPlayer then return end

    CreateBubble(

        player,

        tostring(
            msg.Text
        ),

        messageId

    )
end

-- ============================================================
-- PLAYER SETUP
-- ============================================================

local function SetupPlayer(player)

    -- IMPORTANT:
    -- LocalPlayer is NOT skipped.
    --
    -- This means the addon also prepares
    -- the local player's bubble system.

    player.CharacterAdded:Connect(
        function(character)

            task.wait(0.5)

            local state =
                BubbleState[player]

            if state
                and state.Gui then

                local head =
                    character:FindFirstChild(
                        "Head"
                    )

                if head then

                    state.Gui.Adornee =
                        head

                    state.Gui.Parent =
                        head

                end
            end
        end
    )

    player.CharacterRemoving:Connect(
        function()

            local state =
                BubbleState[player]

            if state then

                if state.Gui
                    and state.Gui.Parent then

                    state.Gui:Destroy()

                end

                BubbleState[player] = nil
            end
        end
    )
end

-- ============================================================
-- INITIAL PLAYERS
-- ============================================================

for _, player
    in ipairs(
        Players:GetPlayers()
    ) do

    SetupPlayer(player)
end

-- ============================================================
-- NEW PLAYERS
-- ============================================================

Players.PlayerAdded:Connect(
    SetupPlayer
)

-- ============================================================
-- PLAYER REMOVAL
-- ============================================================

Players.PlayerRemoving:Connect(
    function(player)

        local state =
            BubbleState[player]

        if state then

            if state.Gui
                and state.Gui.Parent then

                state.Gui:Destroy()

            end
        end

        BubbleState[player] = nil
    end
)

-- ============================================================
-- SERVER CHAT POLLING
-- ============================================================

local Polling = true

task.spawn(function()

    -- Small startup delay.
    task.wait(0.5)

    while Polling do

        local serverData =
            HttpRequest(
                SERVER_MESSAGES_ENDPOINT,
                "GET"
            )

        if serverData
            and type(serverData) == "table" then

            for firebaseId, msg
                in pairs(serverData) do

                if type(msg) == "table" then

                    ProcessServerMessage(
                        firebaseId,
                        msg
                    )

                end
            end
        end

        task.wait(
            POLL_INTERVAL
        )
    end
end)

-- ============================================================
-- KEEP BILLBOARDS ATTACHED
-- ============================================================

task.spawn(function()

    while true do

        task.wait(0.5)

        for player, state
            in pairs(BubbleState) do

            if player
                and player.Parent == Players
                and state
                and state.Gui then

                local head =
                    GetCharacterRoot(player)

                if head
                    and state.Gui.Parent
                        ~= head then

                    state.Gui.Adornee =
                        head

                    state.Gui.Parent =
                        head

                end
            end
        end
    end
end)

-- ============================================================
-- PROCESSED MESSAGE MEMORY CLEANUP
-- ============================================================

task.spawn(function()

    while true do

        task.wait(60)

        local count = 0

        for _ in pairs(
            ProcessedMessages
        ) do

            count = count + 1
        end

        -- Prevent unlimited growth.
        if count > 1000 then

            ProcessedMessages = {}

        end
    end
end)

