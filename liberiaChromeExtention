local looking = false
local function doLookup()
	if looking then return end
	local s = lookBox.Text
	s = (s:gsub("^%s+", ""))
	s = (s:gsub("%s+$", ""))
	s = (s:gsub("^@", ""))
	if s == "" then return end
	looking = true
	lookMsg.TextColor3 = T.mut
	lookMsg.Text = "looking…"
	task.spawn(function()
		local id
		if s:match("^%d+$") then
			id = s
		else
			local ok, res = pcall(function() return Players:GetUserIdFromNameAsync(s) end)
			if ok and res then
				id = string.format("%.0f", res)
			elseif H.request then
				local okr, r = pcall(H.request, { Url = "https://users.roblox.com/v1/usernames/users", Method = "POST",
					Headers = { ["Content-Type"] = "application/json" },
					Body = HttpService:JSONEncode({ usernames = { s }, excludeBannedUsers = false }) })
				if okr and type(r) == "table" and r.StatusCode == 200 and r.Body then
					local okd, d = pcall(function() return HttpService:JSONDecode(r.Body) end)
					if okd and type(d) == "table" and type(d.data) == "table" and d.data[1] and d.data[1].id then
						id = string.format("%.0f", d.data[1].id)
					end
				end
			end
		end
		looking = false
		if not id then
			lookMsg.TextColor3 = T.red
			lookMsg.Text = "player not found"
			return
		end
		lookMsg.Text = ""
		openProfile(id)
	end)
end
