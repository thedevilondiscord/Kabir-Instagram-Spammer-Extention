local function updateMore()
	if hdrRight and hdrRight.Parent then
		hdrRight.Text = full and ("showing " .. #board .. " of " .. #full) or ""
	end
	if not full or #board >= #full then
		more.Visible = false
		return
	end
	more.Visible = true
	more.Text = "Load next " .. math.min(PAGE, #full - #board) .. "  (" .. #board .. " of " .. #full .. ")"
end

local function clearBoardUI()
	for _, c in ipairs(sc:GetChildren()) do
		if c:IsA("GuiObject") and c.LayoutOrder >= 5 and c.LayoutOrder < 100000 then c:Destroy() end
	end
end

local function cmp(a, b)
	if a.c ~= b.c then return a.c > b.c end
	return a.id < b.id
end

-- re-draws the rows already shown (after a removal changed the counts); names come from the cache, so it is instant
function rebuildRows()
	if paging or loadingBoard or not full then
		boardDirty = true
		return
	end
	local keep = math.max(#board, math.min(PAGE, #full))
	clearBoardUI()
	board = {}
	table.sort(full, cmp)
	for i = 1, math.min(keep, #full) do
		local e = full[i]
		local nm = names[e.id]
		e.dn, e.un = nm and nm.dn or ("User " .. e.id), nm and nm.un or ""
		board[i] = e
		makeRow(e, i)
	end
	if #full == 0 then addEmpty(sc, "Nobody has followers.", 5, 50) end
	updateMore()
end

local function showMore()
	if paging or not full then return end
	local from, to = #board + 1, math.min(#board + PAGE, #full)
	if from > to then
		updateMore()
		return
	end
	paging = true
	local my = gen
	more.Text = "Loading…"
	local batch = {}
	for i = from, to do batch[#batch + 1] = full[i] end
	local nextI = 0
	for _ = 1, 5 do
		task.spawn(function()
			while my == gen do
				nextI = nextI + 1
				local e = batch[nextI]
				if not e then return end
				e.dn, e.un = resolve(e.id)
			end
		end)
	end
	for _, e in ipairs(batch) do
		local t0 = os.clock()
		while not e.dn and os.clock() - t0 < 12 and my == gen do task.wait(0.05) end
		if my ~= gen then return end
		if not e.dn then e.dn, e.un = "User " .. e.id, "" end
		board[#board + 1] = e
		makeRow(e, #board)
		if hdrRight and hdrRight.Parent then hdrRight.Text = "loading " .. #board .. "/" .. #full end
	end
	paging = false
	updateMore()
	if boardDirty and not P.root then
		boardDirty = false
		rebuildRows()
	end
end
more.Activated:Connect(function() task.spawn(showMore) end)

