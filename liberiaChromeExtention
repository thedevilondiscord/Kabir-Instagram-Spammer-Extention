-- the moderator list loads a moment after Saiki Rechat starts, so keep checking; the button only exists for moderators
task.spawn(function()
	local t0, told = os.clock(), false
	while alive and H.gui.Parent do
		local m = isMod()
		if m and not told then told = true warn("[SAIKI FOLLOWERS] moderator confirmed, button shown under the chat bubble") end
		if not m and not told and os.clock() - t0 > 20 then
			told = true
			warn("[SAIKI FOLLOWERS] you are not in the moderator list (MODS_URL), so the button stays hidden. isMod=" .. tostring(T.isMod ~= nil))
		end
		if entry.Visible ~= m then entry.Visible = m end
		if not m and (isOpen or win.Visible) then
			isOpen = false
			closeProfile(true)
			win.Visible = false
		end
		task.wait(m and 10 or 2)
	end
end)
