local function refresh()
	if loadingBoard then return end
	if not isMod() then return end
	loadingBoard = true
	gen = gen + 1
	paging = false
	errMsg = nil
	board, full = {}, nil
	boardDirty = false
	clearBoardUI()
	more.Visible = false
	if hdrRight then hdrRight.Text = "loading…" end
	addEmpty(sc, "Loading leaderboard…", 5, 50)
	local ok, data, _, code = FS.req("GET", "/followers")
	if not ok then
		errMsg = "Couldn't load the leaderboard (" .. tostring(code) .. "). Check the sxikiflowsys rules are published."
		loadingBoard = false
		clearBoardUI()
		addEmpty(sc, errMsg, 5, 50)
		if hdrRight then hdrRight.Text = "" end
		return
	end
	local list = {}
	if type(data) == "table" then
		for id, ups in pairs(data) do
			if type(ups) == "table" and tostring(id):match("^%d+$") then
				local n = 0
				for _, r in pairs(ups) do
					n = n + 1
					-- free names: every follower record already carries the follower's own names
					if type(r) == "table" and tonumber(r.rid) and type(r.un) == "string" and r.un ~= "" then
						local rid = string.format("%.0f", tonumber(r.rid))
						if not seen[rid] then
							seen[rid] = { dn = (type(r.dn) == "string" and r.dn ~= "") and r.dn or r.un, un = r.un }
						end
					end
				end
				if n > 0 then list[#list + 1] = { id = tostring(id), c = n } end
			end
		end
	end
	table.sort(list, cmp)
	full = list
	loadingBoard = false
	stamp = os.clock()
	clearBoardUI()
	if #list == 0 then
		addEmpty(sc, "Nobody has followers yet.", 5, 50)
		updateMore()
		return
	end
	showMore()
end
