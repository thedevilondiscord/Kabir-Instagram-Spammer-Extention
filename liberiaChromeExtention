					cnt = math.max(0, (cnt or 1) - 1)
					paint()
					if not (list.Parent and r.Parent) then return end
					r:Destroy()
					tabs.followers.Text = tabLabel("followers", #items)
					nsay(partial and ("Removed " .. it.dn .. " (" .. partial .. ").") or ("Removed " .. it.dn .. " from " .. (name or "their") .. " followers."), not partial)
					if #items == 0 then
						status.Text, status.Visible = "No followers left.", true
					end
				end)
			end)
