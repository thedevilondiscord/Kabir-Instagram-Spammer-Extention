	end)
	local trimBtn = new("TextButton", { Position = U2o(18, 290), Size = U2o(264, 36), BackgroundColor3 = T.red, BackgroundTransparency = 0.2, Text = "Trim followers",
		Font = T.fontB, TextSize = 14, TextColor3 = WHITE, AutoButtonColor = false, ZIndex = 5, Parent = card }, { corner(18) })

	local running, stop, armed = false, false, nil
	P.stop = function() stop = true end
	local function idleTrim()
		armed = nil
		if trimBtn.Parent then trimBtn.Text = "Trim followers" end
	end
	trimBtn.Activated:Connect(function()
		if running then
			stop = true
			say("Stopping…", true)
			return
		end
		if not isMod() then say("Moderators only.") return end
		if not canTouch(id) then say("This account's followers are protected.") return end
		local target = tonumber(box.Text)
		if not target then say("Type the follower count to trim down to.") return end
		target = math.floor(target)
		task.spawn(function()
			if not armed then
				say("Checking…", true)
				local got, code = fetchFollowers(id)
				if P.root ~= root then return end
				if not got then say("Couldn't load followers (" .. tostring(code) .. ").") return end
				if target >= #got then
					say("Already at " .. #got .. ", nothing to remove.", true)
					return
				end
				local token = os.clock()
				armed = { n = #got - target, target = target, token = token }
				trimBtn.Text = "Confirm: remove " .. armed.n
				say(#got .. " → " .. target .. " followers, " .. MODES[mode]:lower() .. ". Tap again within 10 s.", true)
				task.delay(10, function()
					if armed and armed.token == token and not running then idleTrim() end
				end)
				return
			end
			-- confirmed
			local a = armed
			armed = nil
			running, stop = true, false
			trimBtn.Text = "Stop"
			say("Loading followers…", true)
			local got, code = fetchFollowers(id)
			if not got then
				running = false
				idleTrim()
				say("Couldn't load followers (" .. tostring(code) .. ").")
				return
			end
			local n = #got - a.target
			if n <= 0 then
				running = false
				idleTrim()
				say("Already at " .. #got .. ".", true)
				return
			end
			if mode == 2 then
				local rev = {}
				for i = #got, 1, -1 do rev[#rev + 1] = got[i] end
				got = rev
			elseif mode == 3 then
				local rng = Random.new()
				for i = #got, 2, -1 do
					local j = rng:NextInteger(1, i)
					got[i], got[j] = got[j], got[i]
				end
			end
			local queue = {}
			for i = 1, n do queue[i] = got[i] end
			local done, fail, idx, abort, live = 0, 0, 0, nil, 0
			for _ = 1, TRIM_WORKERS do
				live = live + 1
				task.spawn(function()
					while not stop and not abort do
						idx = idx + 1
						local f = queue[idx]
						if not f then break end
						local ok, msg, _, c = removeConn(id, f)
						if ok then
							done = done + 1
							cnt = math.max(0, (cnt or #got) - 1)
						else
							fail = fail + 1
							if c == 401 or c == 403 then abort = msg end
							if done == 0 and fail >= 5 then abort = msg end
						end
						say("Removing " .. (done + fail) .. " / " .. n .. "…", true)
					end
					live = live - 1
				end)
			end
			while live > 0 do task.wait(0.1) end
			running = false
			paint()
			if trimBtn.Parent then trimBtn.Text = "Trim followers" end
			local left = FS.count(id, true)
			if left then cnt = left end
			paint()
			if abort then
				say("Stopped: " .. tostring(abort), false)
			else
				say("Removed " .. done .. (fail > 0 and (", " .. fail .. " failed") or "") .. (stop and " (stopped)" or "") .. ". Now at " .. tostring(cnt) .. ".", fail == 0)
			end
		end)
	end)
	if not canTouch(id) then
		trimBtn.Text = "Protected account"
		trimBtn.BackgroundTransparency = 0.7
	end

	tween(card, 0.22, { GroupTransparency = 0, Position = U2s(0.5, 0.5) })
