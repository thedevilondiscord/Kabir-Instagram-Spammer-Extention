-- ================= moderator gate =================
local function isMod()
	return T.isMod ~= nil and T.isMod(ME) == true
end
local function canTouch(id)
	if PROTECT_OWNER and tostring(id) == OWNER_ID and ME ~= OWNER_ID then return false end
	return true
end
local function why(code)
	if code == 401 or code == 403 then
		return "refused by the follower rules (HTTP " .. tostring(code) .. "). Publish the moderator delete rules in sxikiflowsys"
	end
	return "HTTP " .. tostring(code)
end

-- ================= data =================
local names, seen = {}, {}

local function apiName(id)
	if not H.request then return nil end
	local ok, res = pcall(H.request, { Url = "https://users.roblox.com/v1/users/" .. id, Method = "GET" })
	if ok and type(res) == "table" and res.StatusCode == 200 and res.Body then
		local okd, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
		if okd and type(d) == "table" and type(d.name) == "string" then
			local dn = (type(d.displayName) == "string" and d.displayName ~= "") and d.displayName or d.name
			return { dn = dn, un = d.name }
		end
	end
	return nil
end

-- display name + username of anyone: game, names seen in follower rows, /profiles, Roblox
local function resolve(id)
	id = tostring(id)
	if id == OWNER_ID and id ~= ME then return "BannedAgain_Saiki", "" end
	local nm = names[id]
	if nm then return nm.dn, nm.un end
	local live = Players:GetPlayerByUserId(tonumber(id) or 0)
	if live then
		nm = { dn = live.DisplayName, un = live.Name }
	elseif seen[id] then
		nm = seen[id]
	else
		local okp, pd = FS.req("GET", "/profiles/" .. id)
		if okp and type(pd) == "table" and type(pd.username) == "string" then
			if type(pd.displayName) == "string" and pd.displayName ~= "" and pd.displayName ~= pd.username then
				nm = { dn = pd.displayName, un = pd.username }
			else
				nm = apiName(id) or { dn = pd.username, un = pd.username }
			end
		end
		if not nm then nm = apiName(id) end
		if not nm then
			local oku, un = pcall(function() return Players:GetNameFromUserIdAsync(tonumber(id)) end)
			if oku and un then nm = { dn = un, un = un } else nm = { dn = "User " .. id, un = "" } end
		end
	end
	names[id] = nm
	return nm.dn, nm.un
end

-- /followers/<id>  ->  list of { key = followerFirebaseUid, id = followerRobloxId, dn, un, ts }
local function fetchFollowers(id)
	local ok, data, _, code = FS.req("GET", "/followers/" .. id)
	if not ok then return nil, code end
	local items = {}
	if type(data) == "table" then
		for key, r in pairs(data) do
			if type(r) == "table" then
				local rid = tonumber(r.rid)
				items[#items + 1] = { key = tostring(key), id = rid and string.format("%.0f", rid) or nil,
					dn = tostring(r.dn or r.un or "?"), un = tostring(r.un or ""), ts = tonumber(r.ts) or 0 }
			end
		end
	end
	table.sort(items, function(a, b)
		if a.ts ~= b.ts then return a.ts > b.ts end
		return a.key < b.key
	end)
	return items
end

local function fetchFollowing(id)
	local ok, data, _, code = FS.req("GET", "/following/" .. id)
	if not ok then return nil, code end
	local items = {}
	if type(data) == "table" then
		for tid, r in pairs(data) do
			if tostring(tid):match("^%d+$") then
				items[#items + 1] = { id = tostring(tid), ts = type(r) == "table" and tonumber(r.ts) or 0 }
			end
		end
	end
	table.sort(items, function(a, b)
		if a.ts ~= b.ts then return a.ts > b.ts end
		return a.id < b.id
	end)
	return items
end

local function del(path)
	local code
	for i = 1, 3 do
		local ok, _, _, c = FS.req("DELETE", path)
		code = c
		if ok then return true end
		if c == 401 or c == 403 then break end
		task.wait(0.4 * i)
	end
	return false, code
end

local boardDirty = false
local full -- sorted leaderboard { id, c }

local function adjustBoard(tid, d)
	if not full then return end
	for i, e in ipairs(full) do
		if e.id == tid then
			e.c = e.c - d
			if e.c <= 0 then table.remove(full, i) end
			break
		end
	end
	boardDirty = true
end

-- keeps the main script's own caches honest
local function syncMain(tid, f)
	if FS.cache and FS.cache[tid] and FS.cache[tid].c > 0 then FS.cache[tid].c = FS.cache[tid].c - 1 end
	if tid == ME and FS.followers then
		for i, e in ipairs(FS.followers) do
			if e.id == f.id then table.remove(FS.followers, i) break end
		end
	end
	if f.id then
		if f.id == ME and FS.following then FS.following[tid] = nil end
		if FS.fcache and FS.fcache[f.id] and FS.fcache[f.id].c > 0 then FS.fcache[f.id].c = FS.fcache[f.id].c - 1 end
	end
	if tid == ME and FS.render then pcall(FS.render) end
end

-- THE removal. Cuts the follower <-> target connection on every side:
--   /followers/<target>/<followerUid>   (target's follower list + count)
--   /follows/<followerUid>/<target>     (follower's own "I follow" record)
--   /following/<followerRobloxId>/<target> (follower's following list)
-- returns ok, message, partialNote, httpCode
local function removeConn(tid, f)
	if not isMod() then return false, "moderators only" end
	tid = tostring(tid)
	if not tid:match("^%d+$") then return false, "bad user id" end
	if not canTouch(tid) then return false, "that account's followers are protected" end
	if not (f and f.key and f.key:match("^[%w_%-]+$")) then return false, "bad follower record" end
	local ok, code = del("/followers/" .. tid .. "/" .. f.key)
	if not ok then return false, why(code), nil, code end
	local partial
	local ok2, c2 = del("/follows/" .. f.key .. "/" .. tid)
	if not ok2 then partial = "couldn't clear their follow record (" .. tostring(c2) .. ")" end
	if f.id then
		local ok3, c3 = del("/following/" .. f.id .. "/" .. tid)
		if not ok3 then partial = "couldn't clear their following list (" .. tostring(c3) .. ")" end
	end
	syncMain(tid, f)
	adjustBoard(tid, 1)
	return true, nil, partial
end

